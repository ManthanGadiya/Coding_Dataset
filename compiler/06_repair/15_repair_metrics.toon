repair_metrics:
  metadata:
    id: REP-015
    title: Repair Metrics
    version: 2.0
    status: Stable
    owner: Repair Engine
    depends_on[3]: "- compiler/06_repair/14_repair_pipeline.toon","- compiler/07_quality/02_quality_metrics.toon","- compiler/08_validation/08_metric_validation.toon"
    consumed_by[3]: "- compiler/07_quality/01_quality_engine.toon","- compiler/09_optimization/01_optimizer.toon","- compiler/10_serialization/01_manifest.toon"
    objective[7]: "Measure repair effectiveness,","engineering improvements,","curriculum preservation,","graph integrity,","determinism,",and long-term dataset evolution,using reproducible metrics.
philosophy[8]: measure_before_improve,metrics_drive_quality,engineering_quality_is_quantifiable,preserve_information,deterministic_measurement,reproducible_evaluation,graph_native_metrics,longitudinal_tracking
inputs[9]: repaired_dataset,original_dataset,repair_manifest,repair_history,quality_reports,validation_reports,curriculum_reports,graph_reports,optimization_reports
categories[12]: repair_quality,engineering_quality,semantic_quality,reasoning_quality,graph_quality,curriculum_quality,diversity_quality,confidence_quality,optimization_quality,determinism,reproducibility,efficiency
repair[9]: repaired_failures,unresolved_failures,repair_precision,repair_recall,repair_accuracy,repair_cost,repair_latency,regeneration_rate,rollback_rate
engineering[10]: maintainability,modularity,coupling,cohesion,architecture_compliance,observability,resilience,security,technical_debt,production_readiness
knowledge[8]: completeness,consistency,graph_connectivity,ontology_alignment,evidence_quality,reasoning_depth,curriculum_alignment,knowledge_density
pipeline[7]: execution_time,stage_latency,cache_hit_rate,incremental_repair_ratio,parallel_efficiency,checkpoint_reuse,resource_utilization
longitudinal[8]: quality_trend,repair_trend,recurring_failures,engineering_growth,curriculum_growth,diversity_growth,regression_rate,stability_index
analysis[8]: trend_analysis,anomaly_detection,regression_detection,benchmark_comparison,historical_comparison,capability_growth,graph_evolution,curriculum_evolution
constraints[7]: deterministic,reproducible,statistically_valid,comparable,explainable,benchmarkable,versioned
validation[6]: metric_consistency,statistical_validation,benchmark_validation,trend_validation,reproducibility_validation,report_validation
randomization:
  deterministic_seed: true
  reproducible: true
outputs[8]: repair_metrics,engineering_scorecard,trend_report,benchmark_report,regression_report,optimization_inputs,quality_inputs,metadata
dashboards[6]: repair_dashboard,engineering_dashboard,curriculum_dashboard,graph_dashboard,optimization_dashboard,executive_summary
success_metrics:
  metric_accuracy:
    minimum: 0.999
  determinism:
    minimum: 1.0
  reproducibility:
    minimum: 1.0
  statistical_validity:
    minimum: 0.99
  benchmark_consistency:
    minimum: 0.99
  reporting_completeness:
    minimum: 1.0
