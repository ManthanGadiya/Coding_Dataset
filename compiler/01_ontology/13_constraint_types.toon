```toon id="v3n8kp"
spec:

  id: constraint_types

  version: 1.0.0

  status: stable

  priority: highest

  module: Ontology

  compiler_stage: Knowledge Representation

  description: >
    Defines the complete ontology of engineering constraints.
    Constraints represent the limitations, requirements,
    obligations and environmental conditions that influence
    engineering decisions.
    Every Engineering Knowledge Record shall identify,
    classify and reason about applicable constraints.

###########################################################
# PURPOSE
###########################################################

purpose:

  Represent engineering constraints as
  first-class knowledge objects that shape
  every engineering decision and solution.

###########################################################
# PHILOSOPHY
###########################################################

philosophy:

  Constraints create design.

  Every system is optimized
  for a particular set of constraints.

  Removing or changing constraints
  changes the optimal solution.

###########################################################
# CONSTRAINT MODEL
###########################################################

model:

  Objective

      →

  Constraints

      →

  Alternatives

      →

  Tradeoffs

      →

  Decision

###########################################################
# CONSTRAINT CATEGORIES
###########################################################

categories:

  Technical

  Hardware

  Software

  Performance

  Memory

  Network

  Storage

  Time

  Financial

  Human

  Organizational

  Security

  Privacy

  Reliability

  Availability

  Scalability

  Maintainability

  Compatibility

  Legal

  Regulatory

  Environmental

###########################################################
# TECHNICAL
###########################################################

technical:

  Programming Language

  Runtime

  Compiler

  Platform

  Framework

  API

###########################################################
# HARDWARE
###########################################################

hardware:

  CPU

  GPU

  RAM

