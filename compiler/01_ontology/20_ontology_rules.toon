```toon id="t8v4yn"
spec:

  id: ontology_rules

  version: 1.0.0

  status: stable

  priority: highest

  module: Ontology

  compiler_stage: Semantic Validation

  description: >
    Defines the Universal Ontology Rules (UOR) governing every
    object, relationship, graph, Engineering Knowledge Record,
    Knowledge Atom, Capability, Domain and Entity inside the
    TOON Dataset Compiler.
    These rules ensure semantic consistency, graph integrity,
    deterministic compilation and long-term evolution.

###########################################################
# PURPOSE
###########################################################

purpose:

  Guarantee the correctness,
  consistency,
  integrity,
  explainability
  and reproducibility
  of the Engineering Knowledge Graph.

###########################################################
# PHILOSOPHY
###########################################################

philosophy:

  Knowledge must be consistent.

  Relationships must be explicit.

  Meaning must never be ambiguous.

  Evolution must never break history.

###########################################################
# GLOBAL INVARIANTS
###########################################################

invariants:

  Every object has identity.

  Every object belongs to exactly one
  primary ontology category.

  Every object has metadata.

  Every object participates in the graph.

  Every object is versioned.

  Every object is traceable.

###########################################################
# IDENTITY RULES
###########################################################

identity:

  globally_unique

  immutable

  deterministic

  never_reused

  never_reassigned

###########################################################
# TAXONOMY RULES
###########################################################

taxonomy:

  exactly_one_primary_domain

  exactly_one_primary_category

  multiple_secondary_categories_allowed

  no_duplicate_nodes

  no_orphan_nodes

  acyclic_hierarchy

###########################################################
# ENTITY RULES
###########################################################

entities:

  Every Entity has:

    identity

    type

    lifecycle

    metadata

    relationships

###########################################################
# KNOWLEDGE ATOM RULES
###########################################################

knowledge_atoms:

  Every Knowledge Atom:

    has_definition

    has_purpose

    has_relationships

    has_validation

    is_independently_understandable

###########################################################
# EKR RULES
###########################################################

ekr:

  Every Engineering Knowledge Record:

    has_context

    has_problem

    has_constraints

    has_reasoning

    has_decision

    has_validation

    has_lessons

###########################################################
# RELATIONSHIP RULES
###########################################################

relationships:

  Every relationship:

    has_source

    has_destination

    has_type

    has_direction

    has_semantic_meaning

###########################################################
# GRAPH RULES
###########################################################

graph:

  connected

  deterministic

  traversable

  no_invalid_cycles

  no_isolated_objects

  valid_edge_types

###########################################################
# DEPENDENCY RULES
###########################################################

dependencies:

  explicit

  acyclic_when_required

  traceable

  version_aware

###########################################################
# CAPABILITY RULES
###########################################################

capabilities:

  Every capability:

    measurable

    observable

    composable

    transferable

###########################################################
# REASONING RULES
###########################################################

reasoning:

  Every conclusion:

    requires_evidence

  Every decision:

    requires_tradeoff_analysis

  Every optimization:

    requires_measurement

  Every hypothesis:

    requires_validation

###########################################################
# MEMORY RULES
###########################################################

memory:

  append_only_history

  immutable_identity

  evidence_backed

  graph_linked

###########################################################
# METADATA RULES
###########################################################

metadata:

  complete

  reproducible

  versioned

  auditable

###########################################################
# QUALITY RULES
###########################################################

quality:

  explainable

  reusable

  deterministic

  validated

  educational

###########################################################
# EVOLUTION RULES
###########################################################

evolution:

  preserve_identity

  preserve_history

  preserve_lineage

  preserve_relationships

  never_destroy_provenance

###########################################################
# CONSISTENCY RULES
###########################################################

consistency:

  no_duplicate_identity

  no_conflicting_versions

  no_missing_dependencies

  no_invalid_relationships

###########################################################
# VALIDATION LEVELS
###########################################################

validation:

  syntax

  schema

  semantic

  graph

  reasoning

  quality

  reproducibility

###########################################################
# ERROR SEVERITY
###########################################################

severity:

  INFO

  WARNING

  ERROR

  CRITICAL

  FATAL

###########################################################
# COMPILER ACTIONS
###########################################################

actions:

  accept

  reject

  repair

  regenerate

  quarantine

###########################################################
# REPAIR POLICY
###########################################################

repair:

  missing_metadata

      →

    auto_generate

  broken_relationship

      →

    repair_if_possible

  invalid_reasoning

      →

    regenerate

  duplicate_identity

      →

    reject

###########################################################
# SECURITY RULES
###########################################################

security:

  provenance_required

  checksum_validation

  immutable_release

  audit_logging

###########################################################
# COMPATIBILITY
###########################################################

compatibility:

  backward_compatible

  version_aware

  migration_supported

###########################################################
# ENGINEERING GUARANTEES
###########################################################

guarantees:

  deterministic_generation

  graph_consistency

  explainable_reasoning

  reproducible_compilation

  semantic_integrity

###########################################################
# SUCCESS
###########################################################

success:

  Every Engineering Object
  satisfies all ontology rules.

  Every generated dataset
  is semantically valid.

  Every Engineering Knowledge Graph
  is internally consistent.

###########################################################
# FUTURE
###########################################################

future:

  formal_verification: true

  theorem_validation: true

  graph_constraints: true

  autonomous_repair: true

  ontology_evolution: true
```
