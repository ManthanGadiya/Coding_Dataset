description: "guarantees[5]: Difficulty is multidimensional.,Difficulty is explainable.,Difficulty is reproducible.,Difficulty is measurable.,Difficulty evolves with knowledge."
spec:
  id: difficulty_model
  version: 1.0.0
  status: stable
  priority: critical
  module: Ontology
  compiler_stage: Knowledge Representation
  description: "\"Defines the multidimensional difficulty model used throughout the TOON Dataset Compiler. Difficulty is not determined by code size but by the engineering cognition required to understand, reason about, design, validate and evolve a system.\""
purpose: "\"Represent engineering difficulty as a measurable, multidimensional property used by curriculum learning, dataset generation, benchmarking and model evaluation.\""
dimensions:
  Knowledge:
    description: Amount of prerequisite knowledge.
  Reasoning:
    description: Cognitive reasoning required.
  Engineering:
    description: Engineering judgement required.
  Scale:
    description: Size and interconnectedness.
  Uncertainty:
    description: Missing information.
  Time:
    description: Long-term evolution.
  Interaction:
    description: Number of interacting components.
  Failure:
    description: Difficulty of diagnosing failures.
  Optimization:
    description: Difficulty of improving behaviour.
  Abstraction:
    description: Distance from implementation.
levels:
  D0:
    name: Recognition
  D1:
    name: Understanding
  D2:
    name: Application
  D3:
    name: Analysis
  D4:
    name: Design
  D5:
    name: Expert
  D6:
    name: Research
factors[2]: "increases[10]: Unknown Requirements,Concurrency,Distribution,Security,Scale,Production,Optimization,Legacy Code,Cross Domain Reasoning,Ambiguity","decreases[5]: Isolation,Complete Documentation,Small Scope,Deterministic Behaviour,Well Tested Code"
examples:
  Example_1:
    task: Reverse Linked List
    difficulty: D2
    dominant_dimension: Knowledge
  Example_2:
    task: Design Distributed Cache
    difficulty: D5
    dominant_dimension: Engineering
  Example_3:
    task: Debug Kernel Deadlock
    difficulty: D6
    dominant_dimension: Reasoning
success: "\"Difficulty predicts\"[4]: Learning Order,Dataset Progression,Competency Growth,Curriculum Placement"
future:
  adaptive_difficulty: true
  personalized_curriculum: true
  dynamic_scoring: true
  competency_prediction: true
  automated_calibration: true
