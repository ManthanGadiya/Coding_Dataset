quality_metrics:

  metadata:

    id: QLT-002

    title: Quality Metrics

    version: 2.0

    status: Stable

    owner: Quality Engine

    depends_on:

      - compiler/07_quality/01_quality_engine.toon
      - compiler/03_curriculum/10_master_curriculum.toon
      - compiler/01_ontology/20_ontology_rules.toon

    consumed_by:

      - compiler/06_repair/15_repair_metrics.toon
      - compiler/07_quality/03_knowledge_density.toon
      - compiler/07_quality/04_reasoning_quality.toon
      - compiler/07_quality/05_engineering_quality.toon
      - compiler/07_quality/06_diversity_metrics.toon
      - compiler/07_quality/07_curriculum_quality.toon
      - compiler/07_quality/08_graph_quality.toon

    objective:

      Define standardized, deterministic,
      reproducible quality metrics for evaluating
      engineering datasets, reasoning quality,
      curriculum effectiveness, graph integrity,
      and production readiness.


################################################################################
# PHILOSOPHY
################################################################################

philosophy:

  metrics_define_quality

  measurable_over_subjective

  engineering_over_style

  deterministic_scoring

  benchmark_driven

  reproducible_measurement

  explainable_metrics

  longitudinal_comparison


################################################################################
# INPUTS
################################################################################

inputs:

  repaired_dataset

  engineering_graph

  reasoning_graph

  ontology_graph

  curriculum_graph

  repository_graph

  benchmark_results

  validation_reports

  metadata


################################################################################
# METRIC GROUPS
################################################################################

groups:

  engineering

  reasoning

  architecture

  curriculum

  knowledge

  graph

  diversity

  confidence

  production

  efficiency


################################################################################
# ENGINEERING METRICS
################################################################################

engineering:

  maintainability

  modularity

  cohesion

  coupling

  architecture_compliance

  observability

  security

  resilience

  technical_debt

  deployment_readiness


################################################################################
# REASONING METRICS
################################################################################

reasoning:

  logical_consistency

  evidence_quality

  inference_depth

  tradeoff_quality

  causal_correctness

  assumption_quality

  explanation_quality

  uncertainty_calibration


################################################################################
# KNOWLEDGE METRICS
################################################################################

knowledge:

  completeness

  consistency

  ontology_alignment

  knowledge_density

  prerequisite_coverage

  concept_connectivity

  concept_novelty

  evidence_coverage


################################################################################
# CURRICULUM METRICS
################################################################################

curriculum:

  prerequisite_accuracy

  competency_progression

  spacing_quality

  difficulty_smoothness

  capability_balance

  retention_score

  learning_efficiency

  transferability


################################################################################
# GRAPH METRICS
################################################################################

graph:

  connectivity

  reachability

  dag_validity

  edge_consistency

  node_integrity

  hierarchy_quality

  graph_density

  graph_stability


################################################################################
# SCORING
################################################################################

scoring:

  weighted_average

  geometric_mean

  harmonic_mean

  percentile_rank

  capability_weighting

  curriculum_weighting

  benchmark_normalization

  confidence_weighting


################################################################################
# BENCHMARKS
################################################################################

benchmarks:

  internal_baseline

  previous_release

  gold_standard

  capability_targets

  engineering_targets

  curriculum_targets


################################################################################
# CONSTRAINTS
################################################################################

constraints:

  deterministic

  reproducible

  explainable

  benchmarkable

  statistically_valid

  versioned


################################################################################
# VALIDATION
################################################################################

validation:

  metric_validation

  statistical_validation

  benchmark_validation

  consistency_validation

  reproducibility_validation


################################################################################
# RANDOMIZATION
################################################################################

randomization:

  deterministic_seed:

    true

  reproducible:

    true


################################################################################
# OUTPUTS
################################################################################

outputs:

  metric_scores

  normalized_scores

  benchmark_comparison

  quality_summary

  metric_breakdown

  scorecard

  metadata


################################################################################
# AGGREGATION
################################################################################

aggregation:

  engineering_score

  reasoning_score

  knowledge_score

  curriculum_score

  graph_score

  diversity_score

  production_score

  overall_quality_score


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  metric_consistency:

    minimum: 1.00

  reproducibility:

    minimum: 1.00

  statistical_validity:

    minimum: 0.99

  benchmark_alignment:

    minimum: 0.99

  explainability:

    minimum: 0.99

  determinism:

    minimum: 1.00
