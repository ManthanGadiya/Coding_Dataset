quality_metrics:
  metadata:
    id: QLT-002
    title: Quality Metrics
    version: 2.0
    status: Stable
    owner: Quality Engine
    depends_on[3]: "- compiler/07_quality/01_quality_engine.toon","- compiler/03_curriculum/10_master_curriculum.toon","- compiler/01_ontology/20_ontology_rules.toon"
    consumed_by[7]: "- compiler/06_repair/15_repair_metrics.toon","- compiler/07_quality/03_knowledge_density.toon","- compiler/07_quality/04_reasoning_quality.toon","- compiler/07_quality/05_engineering_quality.toon","- compiler/07_quality/06_diversity_metrics.toon","- compiler/07_quality/07_curriculum_quality.toon","- compiler/07_quality/08_graph_quality.toon"
    objective[5]: "Define standardized, deterministic,",reproducible quality metrics for evaluating,"engineering datasets, reasoning quality,","curriculum effectiveness, graph integrity,",and production readiness.
philosophy[8]: metrics_define_quality,measurable_over_subjective,engineering_over_style,deterministic_scoring,benchmark_driven,reproducible_measurement,explainable_metrics,longitudinal_comparison
inputs[9]: repaired_dataset,engineering_graph,reasoning_graph,ontology_graph,curriculum_graph,repository_graph,benchmark_results,validation_reports,metadata
groups[10]: engineering,reasoning,architecture,curriculum,knowledge,graph,diversity,confidence,production,efficiency
engineering[10]: maintainability,modularity,cohesion,coupling,architecture_compliance,observability,security,resilience,technical_debt,deployment_readiness
reasoning[8]: logical_consistency,evidence_quality,inference_depth,tradeoff_quality,causal_correctness,assumption_quality,explanation_quality,uncertainty_calibration
knowledge[8]: completeness,consistency,ontology_alignment,knowledge_density,prerequisite_coverage,concept_connectivity,concept_novelty,evidence_coverage
curriculum[8]: prerequisite_accuracy,competency_progression,spacing_quality,difficulty_smoothness,capability_balance,retention_score,learning_efficiency,transferability
graph[8]: connectivity,reachability,dag_validity,edge_consistency,node_integrity,hierarchy_quality,graph_density,graph_stability
scoring[8]: weighted_average,geometric_mean,harmonic_mean,percentile_rank,capability_weighting,curriculum_weighting,benchmark_normalization,confidence_weighting
benchmarks[6]: internal_baseline,previous_release,gold_standard,capability_targets,engineering_targets,curriculum_targets
constraints[6]: deterministic,reproducible,explainable,benchmarkable,statistically_valid,versioned
validation[5]: metric_validation,statistical_validation,benchmark_validation,consistency_validation,reproducibility_validation
randomization:
  deterministic_seed: true
  reproducible: true
outputs[7]: metric_scores,normalized_scores,benchmark_comparison,quality_summary,metric_breakdown,scorecard,metadata
aggregation[8]: engineering_score,reasoning_score,knowledge_score,curriculum_score,graph_score,diversity_score,production_score,overall_quality_score
success_metrics:
  metric_consistency:
    minimum: 1.0
  reproducibility:
    minimum: 1.0
  statistical_validity:
    minimum: 0.99
  benchmark_alignment:
    minimum: 0.99
  explainability:
    minimum: 0.99
  determinism:
    minimum: 1.0
