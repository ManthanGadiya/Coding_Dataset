knowledge_density:

  metadata:

    id: QLT-003

    title: Knowledge Density

    version: 2.0

    status: Stable

    owner: Quality Engine

    depends_on:

      - compiler/07_quality/02_quality_metrics.toon
      - compiler/01_ontology/20_ontology_rules.toon
      - compiler/03_curriculum/10_master_curriculum.toon

    consumed_by:

      - compiler/06_repair/10_token_optimizer.toon
      - compiler/07_quality/04_reasoning_quality.toon
      - compiler/09_optimization/02_token_optimizer.toon

    objective:

      Measure the amount of engineering,
      reasoning, architectural, and curriculum
      knowledge conveyed per token while
      minimizing redundancy and maximizing
      long-term learning value.


################################################################################
# PHILOSOPHY
################################################################################

philosophy:

  every_token_should_teach

  engineering_over_text

  reasoning_over_explanation

  compression_without_information_loss

  curriculum_awareness

  graph_native_measurement

  deterministic_scoring

  capability_over_volume


################################################################################
# INPUTS
################################################################################

inputs:

  repaired_dataset

  engineering_graph

  ontology_graph

  reasoning_graph

  curriculum_graph

  repository_graph

  token_statistics

  serialization_metadata

  benchmark_reports


################################################################################
# KNOWLEDGE UNITS
################################################################################

knowledge_units:

  engineering_concepts

  architecture_patterns

  reasoning_steps

  debugging_patterns

  deployment_patterns

  security_patterns

  optimization_patterns

  testing_patterns

  design_patterns

  production_lessons

  failure_patterns

  tradeoffs

  engineering_decisions

  architectural_constraints

  reusable_abstractions


################################################################################
# DENSITY DIMENSIONS
################################################################################

dimensions:

  engineering_density

  reasoning_density

  architecture_density

  curriculum_density

  graph_density

  concept_density

  capability_density

  novelty_density

  production_density

  educational_density


################################################################################
# ANALYSIS
################################################################################

analysis:

  concept_extraction

  redundancy_detection

  information_entropy

  graph_entropy

  concept_connectivity

  curriculum_alignment

  engineering_coverage

  reasoning_coverage

  capability_analysis


################################################################################
# DENSITY CALCULATION
################################################################################

calculation:

  unique_concepts_per_token

  reasoning_steps_per_token

  engineering_patterns_per_token

  graph_information_per_token

  curriculum_progress_per_token

  capability_gain_per_token

  novelty_per_token

  production_knowledge_per_token


################################################################################
# REDUNDANCY DETECTION
################################################################################

redundancy:

  duplicate_reasoning

  duplicate_concepts

  duplicate_patterns

  duplicate_architectures

  duplicate_examples

  duplicate_documentation

  duplicate_context

  duplicate_graphs


################################################################################
# OPTIMIZATION TARGETS
################################################################################

optimization:

  maximize_information

  minimize_redundancy

  preserve_semantics

  preserve_reasoning

  preserve_curriculum

  preserve_graphs

  maximize_learning_gain


################################################################################
# CONSTRAINTS
################################################################################

constraints:

  deterministic

  reproducible

  explainable

  benchmarkable

  lossless

  curriculum_safe

  graph_consistent


################################################################################
# VALIDATION
################################################################################

validation:

  density_validation

  entropy_validation

  redundancy_validation

  graph_validation

  curriculum_validation

  benchmark_validation


################################################################################
# RANDOMIZATION
################################################################################

randomization:

  deterministic_seed:

    true

  reproducible:

    true


################################################################################
# OUTPUTS
################################################################################

outputs:

  density_report

  concept_report

  redundancy_report

  capability_report

  optimization_targets

  token_efficiency

  metadata


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    engineering_density

    reasoning_density

    concept_density

    graph_density

    capability_density

    novelty_density

    redundancy_ratio

    information_entropy

    learning_value

    token_efficiency


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  engineering_density:

    minimum: 0.99

  reasoning_density:

    minimum: 0.99

  redundancy_ratio:

    maximum: 0.05

  learning_value:

    minimum: 0.99

  token_efficiency:

    minimum: 0.99

  determinism:

    minimum: 1.00
