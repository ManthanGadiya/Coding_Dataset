dataset_validation:
  metadata:
    id: VAL-009
    title: Dataset Validation
    version: 2.0
    status: Stable
    owner: Validation Engine
    depends_on[3]: "- compiler/08_validation/08_consistency_validation.toon","- compiler/07_quality/06_diversity_metrics.toon","- compiler/03_curriculum/07_dataset_balancing.toon"
    consumed_by[3]: "- compiler/08_validation/10_final_validation.toon","- compiler/08_validation/11_validation_reports.toon","- compiler/09_optimization/01_dataset_optimizer.toon"
    objective[5]: "Validate the completeness, balance,","coverage, and structural integrity",of the entire dataset as a unified,"collection, ensuring fitness for",downstream training and evaluation.
philosophy[8]: datasets_are_more_than_samples,collection_integrity_matters,balance_enables_generalization,coverage_defines_capability,deterministic_dataset_validation,statistical_rigor,graph_native_aggregation,fitness_for_training
inputs[9]: validated_records,quality_manifest,diversity_report,curriculum_graph,capability_matrix,distribution_statistics,coverage_targets,balance_constraints,training_requirements
dimensions[9]: dataset_completeness,sample_validity,distribution_balance,capability_coverage,domain_coverage,difficulty_distribution,redundancy_ratio,size_constraints,statistical_properties
rules[9]: all_samples_validated,no_duplicate_samples,distribution_within_tolerance,capability_coverage_met,domain_coverage_met,difficulty_range_complete,redundancy_below_threshold,dataset_size_within_bounds,statistical_distributions_valid
analysis[8]: completeness_analysis,distribution_analysis,coverage_analysis,redundancy_detection,statistical_analysis,balance_analysis,gap_analysis,size_validation
failures[10]: incomplete_dataset,duplicate_sample,distribution_imbalance,coverage_gap,domain_missing,difficulty_gap,excessive_redundancy,size_constraint_violation,statistical_anomaly,balance_violation
constraints[7]: deterministic,reproducible,statistically_valid,coverage_complete,balance_maintained,redundancy_controlled,size_bounded
validation[6]: completeness_validation,distribution_validation,coverage_validation,balance_validation,redundancy_validation,determinism_validation
randomization:
  deterministic_seed: true
  reproducible: true
outputs[8]: dataset_validation_report,completeness_report,distribution_report,coverage_report,balance_report,redundancy_report,statistical_summary,metadata
metrics:
  compute[8]: dataset_completeness,distribution_balance,capability_coverage,domain_coverage,redundancy_ratio,statistical_validity,validation_latency,dataset_readiness
success_metrics:
  dataset_completeness:
    minimum: 1.0
  distribution_balance:
    minimum: 0.99
  capability_coverage:
    minimum: 1.0
  redundancy_ratio:
    maximum: 0.01
  determinism:
    minimum: 1.0
