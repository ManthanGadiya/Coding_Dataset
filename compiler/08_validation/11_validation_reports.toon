validation_reports:

  metadata:

    id: VAL-011

    title: Validation Reports

    version: 2.0

    status: Stable

    owner: Validation Engine

    depends_on:

      - compiler/08_validation/10_final_validation.toon
      - compiler/08_validation/02_schema_validation.toon
      - compiler/08_validation/03_graph_validation.toon
      - compiler/08_validation/04_reasoning_validation.toon
      - compiler/08_validation/05_fact_validation.toon
      - compiler/08_validation/06_execution_validation.toon
      - compiler/08_validation/07_security_validation.toon
      - compiler/08_validation/08_consistency_validation.toon
      - compiler/08_validation/09_dataset_validation.toon

    consumed_by:

      - compiler/09_optimization/01_dataset_optimizer.toon
      - compiler/09_optimization/10_optimizer_reports.toon
      - compiler/10_serialization/09_dataset_manifest.toon

    objective:

      Aggregate, format, and produce all
      validation reports in standardized
      formats for downstream consumption
      by optimization, serialization,
      auditing, and release management.


################################################################################
# PHILOSOPHY
################################################################################

philosophy:

  reports_enable_decisions

  standardization_is_required

  every_report_is_auditable

  deterministic_formatting

  machine_readable_by_default

  human_readable_when_needed

  graph_native_serialization

  complete_audit_trail


################################################################################
# INPUTS
################################################################################

inputs:

  final_validation_report

  schema_validation_report

  graph_validation_report

  reasoning_validation_report

  fact_validation_report

  execution_validation_report

  security_validation_report

  consistency_validation_report

  dataset_validation_report

  report_templates

  output_format_configuration


################################################################################
# REPORT TYPES
################################################################################

types:

  executive_summary

  detailed_validation_report

  failure_analysis_report

  determinism_certificate

  reproducibility_certificate

  release_readiness_report

  optimization_feedback_report

  audit_report


################################################################################
# OUTPUT FORMATS
################################################################################

formats:

  toon_report

  json_report

  structured_log

  markdown_summary

  graph_snapshot

  metric_timeseries

  audit_artifact


################################################################################
# ANALYSIS
################################################################################

analysis:

  report_completeness_analysis

  format_compliance_analysis

  data_integrity_analysis

  cross_report_consistency

  audit_trail_completeness


################################################################################
# REPORT GENERATION
################################################################################

generation:

  deterministic_reporting

  template_based_rendering

  multi_format_export

  graph_aware_formatting

  incremental_report_updates

  cache_aware_generation

  parallel_report_assembly


################################################################################
# CONSTRAINTS
################################################################################

constraints:

  deterministic

  reproducible

  format_compliant

  complete

  auditable

  machine_readable

  cross_referenced


################################################################################
# VALIDATION
################################################################################

validation:

  report_integrity_validation

  format_validation

  completeness_validation

  cross_reference_validation

  determinism_validation

  audit_trail_validation


################################################################################
# RANDOMIZATION
################################################################################

randomization:

  deterministic_seed:

    true

  reproducible:

    true


################################################################################
# OUTPUTS
################################################################################

outputs:

  validation_report_bundle

  executive_summary

  detailed_reports

  determinism_certificate

  reproducibility_certificate

  audit_trail

  optimization_feedback

  metadata


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    report_completeness

    format_compliance

    cross_report_consistency

    audit_trail_completeness

    report_generation_latency

    data_integrity


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  report_completeness:

    minimum: 1.00

  format_compliance:

    minimum: 1.00

  cross_report_consistency:

    minimum: 1.00

  audit_trail_completeness:

    minimum: 1.00

  determinism:

    minimum: 1.00
