validation_engine:
  metadata:
    id: VAL-001
    title: Validation Engine
    version: 2.0
    status: Stable
    owner: Validation Engine
    depends_on[3]: "- compiler/07_quality/10_quality_pipeline.toon","- compiler/01_ontology/20_ontology_rules.toon","- compiler/06_repair/14_repair_pipeline.toon"
    consumed_by[9]: "- compiler/08_validation/02_schema_validation.toon","- compiler/08_validation/03_reasoning_validation.toon","- compiler/08_validation/04_engineering_validation.toon","- compiler/08_validation/05_graph_validation.toon","- compiler/08_validation/06_diversity_validation.toon","- compiler/08_validation/07_curriculum_validation.toon","- compiler/08_validation/08_metric_validation.toon","- compiler/08_validation/09_validation_dashboard.toon","- compiler/08_validation/10_validation_pipeline.toon"
    objective[9]: Coordinate deterministic validation of,engineering datasets by verifying,"structural correctness,","semantic consistency,","engineering constraints,","graph integrity,","curriculum validity,","reproducibility,",and formal acceptance criteria.
philosophy[8]: trust_requires_validation,correctness_before_training,deterministic_validation,evidence_before_acceptance,constraints_define_truth,graph_native_validation,reproducibility_is_required,fail_fast
inputs[10]: repaired_dataset,quality_manifest,engineering_graph,ontology_graph,reasoning_graph,curriculum_graph,repository_graph,architecture_graph,benchmark_reports,validation_configuration
domains[12]: schema,semantics,reasoning,engineering,graph,curriculum,diversity,metrics,reproducibility,determinism,security,serialization
checks[12]: schema_integrity,ontology_consistency,reasoning_consistency,engineering_constraints,graph_connectivity,curriculum_validity,diversity_thresholds,metric_consistency,reproducibility,determinism,reference_integrity,dependency_integrity
execution[8]: dependency_graph,topological_execution,deterministic_scheduler,incremental_validation,cache_aware,checkpointing,resumable_execution,parallel_safe
decisions[5]: accept,repair_required,regenerate_required,manual_review,reject
failure_handling[7]: fail_fast,localized_validation,rollback,retry,deterministic_replay,repair_feedback,validation_trace
observability[8]: validation_trace,execution_trace,rule_history,benchmark_trace,failure_statistics,validation_logs,deterministic_hashes,audit_history
constraints[8]: deterministic,reproducible,explainable,benchmarkable,graph_consistent,curriculum_safe,ontology_safe,engineering_safe
validation[6]: rule_validation,consistency_validation,benchmark_validation,determinism_validation,reproducibility_validation,acceptance_validation
randomization:
  deterministic_seed: true
  reproducible: true
outputs[7]: validation_manifest,validation_report,acceptance_decision,failure_report,repair_requests,audit_log,metadata
metrics:
  compute[8]: validation_success_rate,rule_coverage,invariant_coverage,validation_latency,determinism_score,reproducibility_score,acceptance_rate,validation_confidence
success_metrics:
  validation_success_rate:
    minimum: 0.999
  rule_coverage:
    minimum: 1.0
  invariant_coverage:
    minimum: 1.0
  determinism:
    minimum: 1.0
  reproducibility:
    minimum: 1.0
  explainability:
    minimum: 0.99
