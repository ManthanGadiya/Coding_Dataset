constraint_generator:
  metadata:
    description: "depends_on[4]: compiler/05_generation/03_event_generator.toon,compiler/04_world/15_world_state.toon,compiler/03_curriculum/10_master_curriculum.toon,compiler/01_ontology/20_master_ontology.toon consumed_by[4]: compiler/05_generation/05_research_generator.toon,compiler/05_generation/08_code_generator.toon,compiler/05_generation/16_conversation_generator.toon,compiler/05_generation/19_dataset_builder.toon"
    id: GEN-004
    title: Constraint Generator
    version: 1.0
    status: Stable
    owner: Generation Engine
    objective: "\"Generate realistic engineering instructions that communicate tasks with appropriate business context, engineering constraints, role expectations, and evaluation criteria.\""
randomization:
  deterministic_seed: true
  template_variation: enabled
  linguistic_diversity: enabled
