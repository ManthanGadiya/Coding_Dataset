dataset_builder:
  metadata:
    id: GEN-019
    title: Dataset Builder
    version: 2.0
    status: Stable
    owner: Generation Engine
    depends_on[20]: "- compiler/03_curriculum/10_master_curriculum.toon","- compiler/04_world/15_world_state.toon","- compiler/05_generation/01_generation_engine.toon","- compiler/05_generation/02_episode_generator.toon","- compiler/05_generation/03_event_generator.toon","- compiler/05_generation/04_constraint_generator.toon","- compiler/05_generation/05_research_generator.toon","- compiler/05_generation/06_architecture_generator.toon","- compiler/05_generation/07_decision_generator.toon","- compiler/05_generation/08_code_generator.toon","- compiler/05_generation/09_bug_generator.toon","- compiler/05_generation/10_test_generator.toon","- compiler/05_generation/11_review_generator.toon","- compiler/05_generation/12_documentation_generator.toon","- compiler/05_generation/13_memory_generator.toon","- compiler/05_generation/14_artifact_generator.toon","- compiler/05_generation/15_scenario_generator.toon","- compiler/05_generation/16_story_generator.toon","- compiler/05_generation/17_dialog_generator.toon","- compiler/05_generation/18_failure_generator.toon"
    consumed_by[3]: "- compiler/05_generation/20_generation_pipeline.toon","- compiler/07_quality/01_quality_engine.toon","- compiler/08_validation/09_dataset_validation.toon"
    objective[4]: Assemble every generated engineering artifact into,"complete, curriculum-aware, repository-consistent,",production-grade dataset samples suitable for,training autonomous software engineering models.
philosophy[8]: datasets_are_engineered,every_sample_is_self_consistent,context_before_solution,engineering_over_completion,reasoning_before_code,repositories_are_living_systems,failures_are_first_class,curriculum_controls_learning
inputs[17]: engineering_story,engineering_dialogue,engineering_episode,architecture,requirements,implementation,bugs,tests,reviews,documentation,memory,scenarios,artifacts,incidents,world_state,repository_state,curriculum_node
sample[22]: metadata,curriculum,world,repository,business_context,requirements,constraints,architecture,reasoning,engineering_dialogue,implementation,review,testing,deployment,monitoring,failures,debugging,documentation,memory_updates,lessons,quality,validation
sample_types[16]: feature,production_bug,architecture,optimization,migration,research,onboarding,security,infrastructure,deployment,debugging,ai_engineering,autonomous_agent,distributed_system,maintenance,incident_response
curriculum[7]: prerequisite_validation,difficulty_progression,capability_alignment,spacing_algorithm,competency_tracking,diversity_constraints,knowledge_balance
balancing[10]: language_distribution,framework_distribution,domain_distribution,architecture_distribution,repository_distribution,failure_distribution,company_distribution,reasoning_distribution,difficulty_distribution,artifact_distribution
consistency[10]: repository,architecture,timeline,dependencies,terminology,identifiers,company_state,engineering_memory,deployment_history,documentation
quality[9]: engineering_density,knowledge_density,reasoning_density,architectural_depth,production_realism,educational_value,novelty,diversity,maintainability
deduplication[6]: semantic_similarity,graph_similarity,repository_similarity,reasoning_similarity,implementation_similarity,architecture_similarity
randomization:
  deterministic_seed: true
  curriculum_sampling: enabled
  repository_variation: enabled
  engineering_variation: enabled
  organization_variation: enabled
  reproducible: true
validation:
  reject_if[8]: inconsistent_sample,missing_context,curriculum_violation,architecture_conflict,duplicate_sample,impossible_repository,invalid_dependencies,broken_reasoning
outputs[8]: dataset_sample,sample_graph,curriculum_metadata,repository_snapshot,engineering_trace,quality_report,validation_report,dataset_manifest_entry
metrics:
  compute[9]: completeness,engineering_density,knowledge_density,reasoning_depth,production_similarity,diversity,curriculum_alignment,replayability,compression_efficiency
success_metrics:
  completeness:
    minimum: 1.0
  engineering_consistency:
    minimum: 0.99
  curriculum_alignment:
    minimum: 0.99
  production_similarity:
    minimum: 0.99
  educational_value:
    minimum: 0.99
  dataset_quality:
    minimum: 0.99
