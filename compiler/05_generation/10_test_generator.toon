test_generator:

  metadata:

    id: GEN-010

    title: Test Generator

    version: 2.0

    status: Stable

    owner: Generation Engine

    depends_on:

      - compiler/05_generation/08_code_generator.toon

      - compiler/05_generation/09_bug_generator.toon

      - compiler/04_world/15_world_state.toon

      - compiler/01_ontology/20_ontology_rules.toon

    consumed_by:

      - compiler/05_generation/11_review_generator.toon

      - compiler/05_generation/12_documentation_generator.toon

      - compiler/05_generation/19_dataset_builder.toon

    objective:

      Generate comprehensive production-quality testing artifacts
      that verify correctness, robustness, performance,
      security, compatibility, and long-term maintainability.


################################################################################
# CORE PRINCIPLES
################################################################################

principles:

  correctness

  completeness

  reproducibility

  maintainability

  determinism

  repository_consistency

  production_realism

  automation

  traceability


################################################################################
# INPUTS
################################################################################

inputs:

  implementation

  injected_bug

  requirements

  architecture

  dependency_graph

  repository_state

  world_state

  engineering_constraints

  coding_standards


################################################################################
# TEST TYPES
################################################################################

test_types:

  unit

  integration

  end_to_end

  acceptance

  regression

  smoke

  sanity

  contract

  api

  database

  migration

  security

  performance

  load

  stress

  chaos

  compatibility

  accessibility

  snapshot

  property_based

  fuzz

  mutation


################################################################################
# TEST ARTIFACTS
################################################################################

artifacts:

  test_suite

  fixtures

  mocks

  stubs

  fake_services

  seed_data

  assertions

  coverage_report

  benchmark_results


################################################################################
# ASSERTION TYPES
################################################################################

assertions:

  output_correctness

  state_validation

  side_effects

  exception_behavior

  api_contracts

  resource_cleanup

  concurrency

  performance_budget

  security_constraints


################################################################################
# COVERAGE DIMENSIONS
################################################################################

coverage:

  functionality

  edge_cases

  boundary_conditions

  invalid_inputs

  failure_paths

  recovery_paths

  concurrency

  configuration_matrix

  platform_matrix


################################################################################
# TEST EXECUTION
################################################################################

execution:

  deterministic

  isolated

  repeatable

  parallel_safe

  environment_independent


################################################################################
# ENGINEERING CONSTRAINTS
################################################################################

constraints:

  coding_style

  framework_conventions

  repository_layout

  dependency_policy

  ci_requirements

  execution_time_budget


################################################################################
# RANDOMIZATION
################################################################################

randomization:

  deterministic_seed:

    true

  edge_case_sampling:

    enabled

  mutation_targets:

    guided


################################################################################
# VALIDATION
################################################################################

validation:

  reject_if:

    flaky

    non_deterministic

    impossible_assertion

    invalid_fixture

    broken_dependency

    architecture_violation


################################################################################
# OUTPUTS
################################################################################

outputs:

  generated_tests

  fixtures

  expected_results

  coverage_report

  regression_suite

  validation_report


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    coverage_score

    fault_detection_rate

    mutation_score

    regression_strength

    maintainability

    execution_efficiency

    educational_value


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  determinism:

    minimum: 1.00

  coverage:

    minimum: 0.98

  fault_detection:

    minimum: 0.97

  maintainability:

    minimum: 0.97

  repository_consistency:

    minimum: 1.00
