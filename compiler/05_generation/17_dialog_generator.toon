dialog_generator:

  metadata:

    id: GEN-017

    title: Dialog Generator

    version: 2.0

    status: Stable

    owner: Generation Engine

    depends_on:

      - compiler/04_world/15_world_state.toon
      - compiler/05_generation/06_architecture_generator.toon
      - compiler/05_generation/07_decision_generator.toon
      - compiler/05_generation/08_code_generator.toon
      - compiler/05_generation/09_bug_generator.toon
      - compiler/05_generation/10_test_generator.toon
      - compiler/05_generation/11_review_generator.toon
      - compiler/05_generation/15_scenario_generator.toon
      - compiler/05_generation/16_story_generator.toon

    consumed_by:

      - compiler/05_generation/19_dataset_builder.toon

    objective:

      Generate realistic engineering conversations that
      capture collaborative reasoning, technical debate,
      architecture discussions, code reviews, debugging,
      incident response, planning, mentoring,
      and organizational decision making.


################################################################################
# PHILOSOPHY
################################################################################

philosophy:

  engineering_is_collaborative

  communication_shapes_architecture

  disagreement_creates_better_designs

  reasoning_should_be_explicit

  decisions_require_justification

  software_is_built_by_teams

  context_drives_conversation

  discussion_is_training_data


################################################################################
# INPUTS
################################################################################

inputs:

  world_state

  repository_state

  engineering_story

  architecture

  requirements

  incidents

  technical_debt

  roadmap

  engineering_memory

  curriculum_node


################################################################################
# DIALOG TYPES
################################################################################

dialog_types:

  architecture_review

  design_discussion

  code_review

  pull_request

  debugging_session

  pair_programming

  planning_meeting

  sprint_review

  retrospective

  postmortem

  incident_response

  onboarding

  mentoring

  requirement_clarification

  customer_meeting

  executive_review

  technical_interview

  ai_agent_collaboration

  release_review

  security_review


################################################################################
# PARTICIPANTS
################################################################################

participants:

  junior_engineer

  software_engineer

  senior_engineer

  staff_engineer

  principal_engineer

  architect

  engineering_manager

  product_manager

  qa_engineer

  sre

  devops_engineer

  security_engineer

  researcher

  customer

  ai_agent


################################################################################
# CONVERSATION PHASES
################################################################################

conversation_flow:

  context

  problem_definition

  clarification

  exploration

  proposal

  debate

  tradeoff_analysis

  decision

  action_items

  follow_up


################################################################################
# REASONING PATTERNS
################################################################################

reasoning:

  hypothesis

  deduction

  induction

  comparison

  analogy

  root_cause_analysis

  risk_analysis

  failure_analysis

  architectural_reasoning

  cost_benefit_analysis

  systems_thinking


################################################################################
# COMMUNICATION STYLES
################################################################################

styles:

  formal

  collaborative

  mentoring

  critical

  exploratory

  adversarial

  investigative

  educational

  executive_summary

  technical_deep_dive


################################################################################
# ENGINEERING KNOWLEDGE
################################################################################

knowledge:

  architecture

  design_patterns

  distributed_systems

  networking

  databases

  security

  testing

  deployment

  observability

  reliability

  performance

  scalability

  maintainability

  documentation


################################################################################
# CONFLICT MODELS
################################################################################

conflicts:

  differing_architectures

  implementation_disagreement

  timeline_pressure

  business_vs_engineering

  security_vs_usability

  performance_vs_readability

  scalability_vs_cost

  legacy_constraints

  incomplete_information

  ambiguous_requirements


################################################################################
# OUTPUT ARTIFACTS
################################################################################

artifacts:

  dialogue

  decision_log

  rationale

  action_items

  architecture_notes

  review_comments

  implementation_plan

  knowledge_updates


################################################################################
# RANDOMIZATION
################################################################################

randomization:

  deterministic_seed:

    true

  participant_variation:

    enabled

  conflict_variation:

    enabled

  communication_style_variation:

    enabled

  reasoning_variation:

    enabled

  reproducible:

    true


################################################################################
# VALIDATION
################################################################################

validation:

  reject_if:

    unrealistic_dialogue

    inconsistent_history

    missing_reasoning

    contradictory_decisions

    impossible_context

    architecture_violation

    unresolved_dependencies


################################################################################
# OUTPUTS
################################################################################

outputs:

  engineering_dialogue

  structured_reasoning

  conversation_graph

  decisions

  engineering_memory

  repository_updates

  metadata


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    realism

    reasoning_depth

    collaboration_quality

    engineering_density

    architectural_depth

    educational_value

    diversity

    consistency

    decision_quality


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  realism:

    minimum: 0.99

  reasoning_depth:

    minimum: 0.99

  engineering_accuracy:

    minimum: 0.99

  decision_quality:

    minimum: 0.99

  collaboration_quality:

    minimum: 0.98

  educational_value:

    minimum: 0.98
