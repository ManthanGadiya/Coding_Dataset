metrics: "compute[7]: completeness,clarity,technical_accuracy,consistency,maintainability,educational_value,operational_readiness"
success_metrics:
  completeness:
    minimum: 0.99
  consistency:
    minimum: 1.0
  technical_accuracy:
    minimum: 0.99
  operational_readiness:
    minimum: 0.98
  educational_value:
    minimum: 0.98
