story_generator:
  metadata:
    id: GEN-016
    title: Story Generator
    version: 2.0
    status: Stable
    owner: Generation Engine
    depends_on[11]: "- compiler/04_world/15_world_state.toon","- compiler/05_generation/02_episode_generator.toon","- compiler/05_generation/03_event_generator.toon","- compiler/05_generation/06_architecture_generator.toon","- compiler/05_generation/07_decision_generator.toon","- compiler/05_generation/08_code_generator.toon","- compiler/05_generation/09_bug_generator.toon","- compiler/05_generation/10_test_generator.toon","- compiler/05_generation/11_review_generator.toon","- compiler/05_generation/12_documentation_generator.toon","- compiler/05_generation/15_scenario_generator.toon"
    consumed_by[2]: "- compiler/05_generation/17_dialog_generator.toon","- compiler/05_generation/19_dataset_builder.toon"
    objective[8]: Generate complete engineering stories that connect,"business objectives, evolving repositories,","engineering reasoning, implementation,","failures, collaboration, deployment,","maintenance, and long-term software evolution.",Every generated story should resemble the,lifecycle of real engineering work rather than,isolated coding tasks.
philosophy[8]: engineering_is_story,repositories_evolve,decisions_have_history,failures_create_learning,software_is_never_finished,context_matters_more_than_code,architecture_changes_everything,production_is_the_final_teacher
inputs[13]: world_state,repository_state,company_state,engineering_episode,engineering_events,architecture,requirements,roadmap,customer_feedback,incidents,technical_debt,engineering_memory,curriculum_node
story_types[20]: feature_development,startup_growth,production_outage,architecture_migration,legacy_modernization,large_refactoring,bug_hunt,scaling_story,security_incident,performance_optimization,infrastructure_evolution,platform_rewrite,research_to_production,ai_system_evolution,distributed_system_growth,developer_experience,release_cycle,customer_driven_change,emergency_hotfix,long_term_maintenance
story_structure[22]: business_context,engineering_context,repository_history,project_state,stakeholders,objectives,requirements,assumptions,planning,architectural_reasoning,engineering_discussion,implementation,testing,review,deployment,monitoring,failures,debugging,iteration,retrospective,lessons,future_work
characters[15]: software_engineer,senior_engineer,staff_engineer,architect,engineering_manager,product_manager,designer,qa_engineer,sre,devops_engineer,security_engineer,researcher,customer,executive,ai_agent
timeline[10]: proposal,planning,implementation,integration,validation,deployment,production,maintenance,scaling,retirement
events[20]: requirement_change,feature_request,code_review,merge_conflict,deployment_failure,production_bug,security_alert,architecture_review,dependency_upgrade,performance_regression,database_migration,api_breaking_change,customer_feedback,infrastructure_failure,incident_response,rollback,postmortem,optimization,refactoring,release
dimensions[12]: technical,architectural,organizational,operational,business,financial,reliability,scalability,maintainability,security,usability,compliance
conflicts[12]: conflicting_requirements,deadline_pressure,limited_resources,technical_debt,legacy_constraints,architecture_limitations,scaling_limits,organizational_disagreement,customer_pressure,production_failures,incomplete_information,uncertain_requirements
causal_chain[10]: trigger,root_cause,engineering_decisions,implementation,consequences,mitigation,validation,outcome,organizational_learning,knowledge_update
quality[10]: realism,causal_consistency,engineering_accuracy,repository_consistency,historical_consistency,character_consistency,architectural_consistency,technical_depth,educational_value,replayability
memory:
  preserve[11]: architecture_history,engineering_decisions,technical_debt,customer_history,incidents,deployment_history,previous_failures,previous_successes,repository_evolution,engineering_culture,recurring_patterns
randomization:
  deterministic_seed: true
  timeline_variation: enabled
  organization_variation: enabled
  repository_variation: enabled
  character_variation: enabled
  incident_variation: enabled
  architecture_variation: enabled
  reproducible: true
validation:
  reject_if[8]: impossible_timeline,inconsistent_history,architecture_conflict,unrealistic_engineering,contradictory_events,impossible_repository_state,missing_causality,broken_story_flow
outputs[10]: engineering_story,timeline,event_graph,repository_evolution,decision_log,architecture_history,implementation_history,failure_history,learning_history,metadata
metrics:
  compute[9]: realism_score,engineering_density,causal_depth,architectural_depth,repository_evolution_score,educational_value,narrative_consistency,production_similarity,diversity_score
success_metrics:
  realism:
    minimum: 0.99
  engineering_accuracy:
    minimum: 0.99
  causal_consistency:
    minimum: 0.99
  repository_consistency:
    minimum: 1.0
  architectural_consistency:
    minimum: 0.99
  educational_value:
    minimum: 0.98
  replayability:
    minimum: 0.95
