description: "principles[8]: deterministic,reproducible,role_aware,engineering_realistic,context_preserving,technically_correct,collaborative,traceable participants[14]: junior_engineer,software_engineer,senior_engineer,staff_engineer,principal_engineer,tech_lead,architect,engineering_manager,product_manager,sre,qa_engineer,security_engineer,customer,support_engineer dialogue_types[13]: design_review,code_review,architecture_discussion,sprint_planning,incident_response,debugging_session,mentoring,pair_programming,feature_refinement,technical_interview,customer_meeting,retrospective,postmortem messages[12]: question,clarification,proposal,alternative,agreement,disagreement,concern,evidence,recommendation,decision,action_item,summary structure[8]: context,participants,agenda,discussion,technical_analysis,decision,action_items,follow_up styles[8]: formal,collaborative,mentoring,technical,executive,incident_response,review,instructional topics[13]: architecture,implementation,debugging,testing,deployment,monitoring,observability,documentation,dependencies,scalability,performance,security,technical_debt decisions[7]: proposed_solution,accepted_solution,rejected_alternatives,rationale,tradeoffs,owners,deadlines outputs[6]: conversation,action_items,engineering_decisions,unresolved_questions,meeting_summary,metadata"
architecture_generator:
  metadata:
    description: "depends_on[4]: compiler/05_generation/05_research_generator.toon,compiler/04_world/15_world_state.toon,compiler/04_world/06_engineer_profiles.toon,compiler/04_world/07_roles.toon consumed_by[5]: compiler/05_generation/08_code_generator.toon,compiler/05_generation/11_review_generator.toon,compiler/05_generation/16_conversation_generator.toon,compiler/05_generation/18_reflection_generator.toon,compiler/05_generation/19_dataset_builder.toon"
    id: GEN-006
    title: Architecture Generator
    version: 1.0
    status: Stable
    owner: Generation Engine
    objective: "\"Generate realistic software engineering conversations between stakeholders while preserving technical accuracy, organizational context, and engineering intent.\""
randomization:
  deterministic_seed: true
  role_specific_language: true
  communication_variation: enabled
  reproducible: true
