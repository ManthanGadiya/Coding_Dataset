architecture_generator:

  metadata:

    id: GEN-006

    title: Architecture Generator

    version: 1.0

    status: Stable

    owner: Generation Engine

    depends_on:

      - compiler/05_generation/05_research_generator.toon
      - compiler/04_world/15_world_state.toon
      - compiler/04_world/06_engineer_profiles.toon
      - compiler/04_world/07_roles.toon

    consumed_by:

      - compiler/05_generation/08_code_generator.toon
      - compiler/05_generation/11_review_generator.toon
      - compiler/05_generation/16_conversation_generator.toon
      - compiler/05_generation/18_reflection_generator.toon
      - compiler/05_generation/19_dataset_builder.toon

    objective:

      Generate realistic software engineering conversations
      between stakeholders while preserving technical accuracy,
      organizational context, and engineering intent.


################################################################################
# CORE PRINCIPLES
################################################################################

principles:

  - deterministic

  - reproducible

  - role_aware

  - engineering_realistic

  - context_preserving

  - technically_correct

  - collaborative

  - traceable


################################################################################
# PARTICIPANTS
################################################################################

participants:

  junior_engineer

  software_engineer

  senior_engineer

  staff_engineer

  principal_engineer

  tech_lead

  architect

  engineering_manager

  product_manager

  sre

  qa_engineer

  security_engineer

  customer

  support_engineer


################################################################################
# ARCHITECTURE TYPES
################################################################################

dialogue_types:

  design_review

  code_review

  architecture_discussion

  sprint_planning

  incident_response

  debugging_session

  mentoring

  pair_programming

  feature_refinement

  technical_interview

  customer_meeting

  retrospective

  postmortem


################################################################################
# MESSAGE TYPES
################################################################################

messages:

  question

  clarification

  proposal

  alternative

  agreement

  disagreement

  concern

  evidence

  recommendation

  decision

  action_item

  summary


################################################################################
# CONVERSATION STRUCTURE
################################################################################

structure:

  context

  participants

  agenda

  discussion

  technical_analysis

  decision

  action_items

  follow_up


################################################################################
# COMMUNICATION STYLE
################################################################################

styles:

  formal

  collaborative

  mentoring

  technical

  executive

  incident_response

  review

  instructional


################################################################################
# ENGINEERING TOPICS
################################################################################

topics:

  architecture

  implementation

  debugging

  testing

  deployment

  monitoring

  observability

  documentation

  dependencies

  scalability

  performance

  security

  technical_debt


################################################################################
# DECISION RECORDING
################################################################################

decisions:

  proposed_solution

  accepted_solution

  rejected_alternatives

  rationale

  tradeoffs

  owners

  deadlines


################################################################################
# OUTPUTS
################################################################################

outputs:

  conversation

  action_items

  engineering_decisions

  unresolved_questions

  meeting_summary

  metadata


################################################################################
# RANDOMIZATION
################################################################################

randomization:

  deterministic_seed:

    true

  role_specific_language:

    true

  communication_variation:

    enabled

  reproducible:

    true


################################################################################
# VALIDATION
################################################################################

validation:

  reject_if:

    inconsistent_roles

    missing_context

    contradictory_decisions

    unrealistic_dialogue

    unsupported_claims

    incomplete_action_items


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    realism

    technical_accuracy

    collaboration_quality

    role_consistency

    communication_clarity

    decision_traceability

    educational_value


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  engineering_realism:

    minimum: 0.99

  technical_accuracy:

    minimum: 0.99

  role_consistency:

    minimum: 0.98

  communication_quality:

    minimum: 0.97

  decision_traceability:

    minimum: 0.98

  reproducibility:

    minimum: 1.00
