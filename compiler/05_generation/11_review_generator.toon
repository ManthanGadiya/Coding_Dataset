review_generator:

  metadata:

    id: GEN-011

    title: Review Generator

    version: 2.0

    status: Stable

    owner: Generation Engine

    depends_on:

      - compiler/05_generation/08_code_generator.toon

      - compiler/05_generation/09_bug_generator.toon

      - compiler/05_generation/10_test_generator.toon

      - compiler/04_world/15_world_state.toon

      - compiler/01_ontology/20_ontology_rules.toon

    consumed_by:

      - compiler/05_generation/12_documentation_generator.toon

      - compiler/05_generation/19_dataset_builder.toon

    objective:

      Generate realistic senior-engineer code reviews
      that evaluate correctness, architecture,
      maintainability, security, performance,
      readability, and long-term engineering quality.


################################################################################
# CORE PRINCIPLES
################################################################################

principles:

  engineering_judgement

  constructiveness

  traceability

  repository_consistency

  maintainability

  educational_value

  architecture_awareness

  fairness

  production_focus


################################################################################
# INPUTS
################################################################################

inputs:

  implementation

  test_results

  injected_bug

  requirements

  architecture

  repository_state

  dependency_graph

  coding_standards

  world_state

  historical_reviews


################################################################################
# REVIEW DIMENSIONS
################################################################################

dimensions:

  correctness

  architecture

  maintainability

  readability

  modularity

  abstraction

  performance

  security

  reliability

  scalability

  observability

  documentation

  testing

  dependency_management

  backward_compatibility


################################################################################
# REVIEW TYPES
################################################################################

review_types:

  feature_review

  bug_fix_review

  security_review

  architecture_review

  performance_review

  api_review

  migration_review

  infrastructure_review

  refactoring_review


################################################################################
# REVIEW COMMENTS
################################################################################

comment_categories:

  suggestion

  improvement

  blocking_issue

  nitpick

  design_concern

  security_warning

  performance_warning

  documentation_request

  testing_gap

  clarification_request

  architectural_feedback


################################################################################
# ENGINEERING CONTEXT
################################################################################

context:

  repository_history

  ownership

  previous_reviews

  coding_guidelines

  technical_debt

  release_constraints

  deployment_history


################################################################################
# REVIEW DECISIONS
################################################################################

decisions:

  approve

  approve_with_comments

  request_changes

  reject

  escalate_architecture_review


################################################################################
# RANDOMIZATION
################################################################################

randomization:

  deterministic_seed:

    true

  reviewer_personality:

    enabled

  strictness_level:

    adaptive

  repository_consistent:

    true


################################################################################
# VALIDATION
################################################################################

validation:

  reject_if:

    contradictory_feedback

    impossible_suggestion

    architecture_inconsistency

    invalid_reasoning

    unsupported_claim

    duplicate_comments


################################################################################
# OUTPUTS
################################################################################

outputs:

  review_comments

  summary

  blocking_issues

  improvement_suggestions

  approval_status

  review_metrics

  educational_feedback


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    review_quality

    engineering_depth

    actionability

    educational_value

    consistency

    architecture_alignment

    reviewer_confidence


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  engineering_depth:

    minimum: 0.99

  actionability:

    minimum: 0.98

  repository_consistency:

    minimum: 1.00

  educational_value:

    minimum: 0.98

  reviewer_accuracy:

    minimum: 0.99
