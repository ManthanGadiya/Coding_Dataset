failure_generator:

  metadata:

    id: GEN-018

    title: Failure Generator

    version: 2.0

    status: Stable

    owner: Generation Engine

    depends_on:

      - compiler/04_world/15_world_state.toon
      - compiler/05_generation/02_episode_generator.toon
      - compiler/05_generation/03_event_generator.toon
      - compiler/05_generation/06_architecture_generator.toon
      - compiler/05_generation/07_decision_generator.toon
      - compiler/05_generation/08_code_generator.toon
      - compiler/05_generation/09_bug_generator.toon
      - compiler/05_generation/10_test_generator.toon
      - compiler/05_generation/11_review_generator.toon
      - compiler/05_generation/16_story_generator.toon
      - compiler/05_generation/17_dialog_generator.toon

    consumed_by:

      - compiler/05_generation/19_dataset_builder.toon

    objective:

      Generate realistic engineering failures,
      production incidents, architectural mistakes,
      debugging journeys, recovery strategies,
      and organizational learning that teach
      robust engineering rather than idealized success.


################################################################################
# PHILOSOPHY
################################################################################

philosophy:

  failure_is_data

  incidents_drive_learning

  root_causes_matter

  prevention_is_better_than_recovery

  every_failure_has_context

  resilient_systems_expect_failure

  postmortems_are_learning_assets

  engineering_is_iterative


################################################################################
# INPUTS
################################################################################

inputs:

  world_state

  repository_state

  architecture

  engineering_story

  engineering_dialogue

  implementation

  deployment_history

  dependency_graph

  technical_debt

  observability_data

  curriculum_node


################################################################################
# FAILURE TYPES
################################################################################

failure_types:

  logic_bug

  concurrency_bug

  race_condition

  deadlock

  memory_leak

  resource_exhaustion

  api_breaking_change

  deployment_failure

  rollback_failure

  configuration_error

  dependency_conflict

  security_vulnerability

  authentication_failure

  authorization_failure

  data_corruption

  migration_failure

  cache_invalidation

  distributed_consistency

  timeout

  network_partition

  scaling_failure

  monitoring_gap

  observability_failure

  flaky_test

  infrastructure_outage

  human_error

  requirement_misunderstanding

  architectural_mistake


################################################################################
# ROOT CAUSE MODEL
################################################################################

root_causes:

  incorrect_assumption

  incomplete_requirements

  hidden_dependency

  design_flaw

  implementation_error

  operational_mistake

  communication_failure

  missing_validation

  technical_debt

  organizational_constraint

  unknown_external_factor


################################################################################
# FAILURE LIFECYCLE
################################################################################

lifecycle:

  latent_state

  triggering_event

  symptom_detection

  investigation

  hypothesis_generation

  debugging

  root_cause_identification

  mitigation

  permanent_fix

  validation

  postmortem

  knowledge_capture


################################################################################
# RECOVERY STRATEGIES
################################################################################

recovery:

  rollback

  hotfix

  feature_flag_disable

  traffic_shift

  canary_redeployment

  database_restore

  cache_flush

  dependency_pin

  emergency_patch

  gradual_rollout

  architectural_refactor


################################################################################
# OBSERVABILITY
################################################################################

observability:

  metrics

  logs

  traces

  alerts

  dashboards

  health_checks

  error_reports

  customer_reports


################################################################################
# LEARNING OUTPUT
################################################################################

learning:

  root_cause

  lessons_learned

  prevention_strategy

  architecture_improvement

  coding_guideline_update

  monitoring_update

  testing_update

  documentation_update

  process_improvement


################################################################################
# RANDOMIZATION
################################################################################

randomization:

  deterministic_seed:

    true

  incident_variation:

    enabled

  infrastructure_variation:

    enabled

  recovery_variation:

    enabled

  severity_variation:

    enabled

  reproducible:

    true


################################################################################
# VALIDATION
################################################################################

validation:

  reject_if:

    impossible_failure

    inconsistent_root_cause

    unrealistic_recovery

    missing_postmortem

    broken_causality

    inconsistent_repository

    invalid_architecture


################################################################################
# OUTPUTS
################################################################################

outputs:

  incident_report

  failure_timeline

  debugging_trace

  root_cause_analysis

  recovery_plan

  postmortem

  engineering_updates

  repository_changes

  metadata


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    realism

    causal_depth

    debugging_complexity

    recovery_quality

    educational_value

    architectural_learning

    observability_quality

    resilience_score


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  realism:

    minimum: 0.99

  root_cause_accuracy:

    minimum: 0.99

  debugging_quality:

    minimum: 0.99

  recovery_quality:

    minimum: 0.99

  educational_value:

    minimum: 0.99

  resilience_learning:

    minimum: 0.98
