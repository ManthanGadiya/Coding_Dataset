release_format:
  metadata:
    id: SER-008
    title: Release Format
    version: 2.0
    status: Stable
    owner: Serialization Engine
    depends_on[3]: "- compiler/10_serialization/07_export_pipeline.toon","- compiler/10_serialization/06_token_compression.toon","- compiler/09_optimization/08_sampling_optimizer.toon"
    consumed_by[3]: "- compiler/10_serialization/09_dataset_manifest.toon","- compiler/10_serialization/10_export_targets.toon","- compiler/00_core/03_pipeline.toon"
    objective[6]: Define the canonical release format,for the compiled dataset including,"directory structure, file naming,","shard organization, metadata layout,","integrity verification, and versioning",conventions for all distribution targets.
philosophy[8]: release_is_a_product,structure_enables_usability,naming_conveys_meaning,sharding_enables_scale,deterministic_release_structure,self_describing_release,integrity_verified_content,version_tracked_releases
inputs[8]: export_pipeline_output,release_version,distribution_requirements,storage_constraints,naming_conventions,sharding_policy,integrity_policy,metadata_requirements
structure[8]: root_manifest,dataset_directory,shard_directories,metadata_directory,graph_directory,benchmark_directory,documentation_directory,checksum_manifests
conventions[7]: dataset_name_standard,shard_naming_pattern,file_extension_mapping,version_embedding,timestamp_format,content_hash_inclusion,language_tag_convention
sharding[7]: size_based_sharding,count_based_sharding,capability_based_sharding,domain_based_sharding,balanced_sharding,deterministic_shard_assignment,shard_reference_cross_links
constraints[7]: deterministic,reproducible,self_describing,integrity_verified,versioned,scalable,storage_efficient
validation[6]: structure_validation,naming_validation,sharding_validation,integrity_validation,metadata_validation,determinism_validation
randomization:
  deterministic_seed: true
  reproducible: true
outputs[7]: release_format_specification,directory_templates,naming_guide,sharding_plan,integrity_verification_procedure,metadata_layout,metadata
metrics:
  compute[6]: format_completeness,naming_consistency,shard_balance,metadata_coverage,self_description_completeness,integrity_verifiability
success_metrics:
  format_completeness:
    minimum: 1.0
  naming_consistency:
    minimum: 1.0
  shard_balance:
    minimum: 0.95
  metadata_coverage:
    minimum: 1.0
  determinism:
    minimum: 1.0
