    objective[5]: Define the canonical TOON specification,"including syntax, grammar, type system,","schema rules, serialization format,","versioning conventions, and compatibility",guarantees for the entire dataset compiler.
philosophy[8]: spec_is_the_contract,format_follows_function,human_readable_by_default,machine_parseable_always,deterministic_serialization,versioned_evolution,backward_compatible_changes,self_describing_format
inputs[7]: metadata_specification,ontology_definitions,serialization_requirements,format_constraints,versioning_policy,compatibility_requirements,export_target_definitions
dimensions[8]: syntax_grammar,type_system,schema_language,serialization_format,versioning_scheme,compatibility_rules,extension_mechanism,self_describing_metadata
syntax[9]: indentation_based_structure,key_value_delimiter,list_notation,multiline_values,comments,identifiers,references,includes,annotations
types[12]: string,integer,float,boolean,timestamp,identifier,reference,enum,list,map,structure,any
versioning[6]: major_version_breaking,minor_version_backward_compatible,patch_version_bug_fixes,spec_evolution_process,deprecation_policy,migration_guides
constraints[7]: deterministic_parsing,unambiguous_syntax,complete_specification,backward_compatible,forward_compatible_when_possible,self_validating,extensible
validation[6]: syntax_validation,type_validation,schema_compliance_validation,version_compatibility_validation,spec_completeness_validation,determinism_validation
