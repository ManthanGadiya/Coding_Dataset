dataset_optimizer:
  metadata:
    id: OPT-001
    title: Dataset Optimizer
    version: 2.0
    status: Stable
    owner: Optimization Engine
    depends_on[3]: "- compiler/08_validation/10_final_validation.toon","- compiler/07_quality/10_quality_pipeline.toon","- compiler/03_curriculum/07_dataset_balancing.toon"
    consumed_by[5]: "- compiler/09_optimization/02_token_optimizer.toon","- compiler/09_optimization/03_graph_optimizer.toon","- compiler/09_optimization/04_deduplication.toon","- compiler/09_optimization/06_balancing_optimizer.toon","- compiler/09_optimization/10_optimizer_reports.toon"
    objective[7]: Coordinate the end-to-end optimization,of the validated dataset by orchestrating,"token optimization, graph optimization,","deduplication, balancing, compression,","curriculum optimization, sampling optimization,",and release optimization into a single,deterministic pipeline.
philosophy[8]: optimization_is_iterative,quality_must_be_preserved,efficiency_enables_scale,every_token_has_cost,deterministic_optimization,graph_native_transformations,benchmark_confirmed_improvements,explainable_transformations
inputs[10]: validated_dataset,validation_reports,quality_manifest,optimization_configuration,token_budget,compression_targets,balancing_requirements,curriculum_constraints,release_requirements,benchmark_suite
dimensions[8]: token_efficiency,graph_efficiency,deduplication,dataset_balancing,compression_ratio,curriculum_quality,sampling_quality,release_optimization
execution[8]: dependency_graph,topological_optimization,deterministic_execution,incremental_optimization,cache_aware,checkpointing,resumable_execution,parallel_safe
stages[10]: initialize,deduplicate,balance,optimize_tokens,optimize_graph,optimize_curriculum,optimize_sampling,compress,optimize_release,generate_reports
failure_handling[6]: retry,rollback,checkpoint_restore,localized_optimization,deterministic_replay,graceful_degradation
constraints[7]: deterministic,reproducible,quality_preserving,benchmark_verified,incrementally_applicable,cache_aware,resource_bounded
validation[6]: optimization_validation,quality_preservation_validation,benchmark_validation,consistency_validation,determinism_validation,reproducibility_validation
randomization:
  deterministic_seed: true
  reproducible: true
outputs[8]: optimized_dataset,optimization_manifest,optimization_reports,benchmark_comparisons,compression_report,execution_graph,downstream_inputs,metadata
metrics:
  compute[9]: overall_efficiency,token_reduction,graph_reduction,deduplication_rate,balance_score,compression_ratio,curriculum_quality,optimization_latency,quality_preservation
success_metrics:
  overall_efficiency:
    minimum: 0.95
  token_reduction:
    minimum: 0.3
  deduplication_rate:
    minimum: 0.99
  quality_preservation:
    minimum: 0.99
  determinism:
    minimum: 1.0
