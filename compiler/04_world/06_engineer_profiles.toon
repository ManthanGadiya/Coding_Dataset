description: "\"behavior[10]: pull_request_size,review_depth,testing_habits,documentation_habits,refactoring_frequency,risk_tolerance,ownership_level,collaboration_score,incident_participation,knowledge_sharing knowledge[7]: mastered_domains,developing_domains,unfamiliar_domains,certifications,completed_projects,architecture_experience,production_experience growth[7]: promotions,skill_progression,technology_adoption,mentorship,project_rotation,specialization,leadership_development\""
engineer_profiles:
  metadata:
    description: "\"depends_on[3]: compiler/04_world/05_team_generator.toon,compiler/01_ontology/17_entity_model.toon,compiler/03_curriculum/12_competency_matrix.toon consumed_by[6]: compiler/04_world/07_roles.toon,compiler/04_world/09_repository_history.toon,compiler/04_world/10_incident_generator.toon,compiler/05_generation/02_episode_generator.toon,compiler/05_generation/11_review_generator.toon,compiler/05_generation/16_dialogue_generator.toon\""
    id: WORLD-006
    title: Engineer Profiles
    version: 1.0
    status: Stable
    owner: World Engine
    objective: "\"\\\"Generate realistic software engineers with evolving knowledge, skills, responsibilities, experience, personalities, and engineering behavior.\\\"\""
experience:
  intern:
    years: 0-1
  junior:
    years: 1-3
  mid:
    years: 3-6
  senior:
    years: 6-10
  staff:
    years: 10-15
  principal:
    years: 15+
  distinguished:
    years: 20+
relationships:
  description: "\"belongs_to[2]: company,team contributes_to[3]: repositories,services,documentation\""
  reviews: pull_requests
  mentors: junior_engineers
randomization:
  deterministic_seed: true
  weighted_generation: true
  realistic_distribution: true
  reproducible: true
validation: "\"reject_if[6]: missing_team,missing_role,inconsistent_experience,impossible_skill_progression,invalid_competency,orphan_engineer\""
metrics: "\"compute[8]: competency_score,engineering_maturity,collaboration_quality,review_quality,architecture_experience,production_experience,learning_velocity,knowledge_breadth\""
success_metrics:
  competency_consistency:
    minimum: 1.0
  engineering_realism:
    minimum: 0.97
  behavioral_consistency:
    minimum: 0.95
  collaboration_realism:
    minimum: 0.95
  reproducibility:
    minimum: 1.0
  profile_diversity:
    minimum: 0.95
