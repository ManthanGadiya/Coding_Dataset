    objective: "\"Generate realistic software companies with coherent business, engineering, financial, and organizational characteristics.\""
engineering[4]: "architecture_style[6]: monolith,modular_monolith,microservices,event_driven,serverless,hybrid","deployment_model[4]: cloud,on_premise,hybrid,edge","engineering_maturity[4]: experimental,growing,mature,elite","testing_culture[4]: low,moderate,strong,rigorous"
technology[3]: "languages[9]: C,C++,Rust,Go,Java,Kotlin,Python,JavaScript,TypeScript","databases[6]: PostgreSQL,MySQL,SQLite,MongoDB,Redis,Cassandra","infrastructure[7]: Docker,Kubernetes,Terraform,Kafka,RabbitMQ,Prometheus,Grafana"
relationships:
  description: "owns[5]: repositories,projects,teams,infrastructure,products employs[4]: engineers,managers,architects,researchers"
  serves: customers
randomization:
  deterministic_seed: true
  weighted_generation: true
  reproducible: true
  diversity_bias: enabled
validation: "reject_if[6]: missing_industry,invalid_employee_count,inconsistent_budget,impossible_growth,missing_departments,orphan_projects"
metrics: "measure[6]: organizational_complexity,engineering_maturity,technology_diversity,business_realism,operational_scale,company_consistency"
success_metrics:
  realism:
    minimum: 0.95
  consistency:
    minimum: 1.0
