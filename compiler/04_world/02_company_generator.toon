description: "organization[10]: executive,product,engineering,infrastructure,security,qa,design,customer_success,support,research constraints[8]: budget,deadlines,regulations,compliance,hiring,customer_commitments,technical_debt,infrastructure_cost culture[8]: innovation,quality,speed,reliability,security,documentation,experimentation,learning"
company_generator:
  metadata:
    description: "depends_on[2]: compiler/04_world/01_world_generator.toon,compiler/01_ontology/17_entity_model.toon consumed_by[5]: compiler/04_world/03_repository_generator.toon,compiler/04_world/04_project_generator.toon,compiler/04_world/05_team_generator.toon,compiler/04_world/08_business_events.toon,compiler/04_world/14_company_growth.toon"
