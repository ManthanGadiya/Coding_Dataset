description: "business_impact[8]: revenue,customer_retention,reputation,market_share,growth,support_cost,sales_pipeline,contract_renewal lifecycle[9]: received,categorized,triaged,prioritized,assigned,implemented,validated,customer_notified,closed"
customer_feedback:
  metadata:
    description: "depends_on[6]: compiler/04_world/02_company_generator.toon,compiler/04_world/04_project_generator.toon,compiler/04_world/08_business_events.toon,compiler/04_world/10_incident_generator.toon,compiler/04_world/11_feature_requests.toon,compiler/04_world/12_technical_debt.toon consumed_by[5]: compiler/04_world/14_company_growth.toon,compiler/04_world/15_world_state.toon,compiler/05_generation/02_episode_generator.toon,compiler/05_generation/15_scenario_generator.toon,compiler/05_generation/18_reflection_generator.toon"
    id: WORLD-013
    title: Customer Feedback
    version: 1.0
    status: Stable
    owner: World Engine
    objective: "\"Generate realistic customer interactions, feedback, satisfaction trends, adoption metrics, and business outcomes that influence engineering decisions.\""
satisfaction: "metrics[9]: nps,csat,ces,retention,churn,adoption,engagement,renewal_rate,support_resolution_time"
engineering_impact: "affects[9]: roadmap,feature_priority,architecture,technical_debt,incident_priority,documentation,testing,observability,staffing"
causality:
  feedback[2]: "originates_from[6]: feature_release,production_incident,technical_debt,usability,performance,customer_expectations","may_trigger[6]: feature_request,bug_fix,roadmap_change,architecture_review,business_event,engineering_investment"
validation: "reject_if[6]: missing_customer_segment,missing_business_impact,invalid_feedback_type,inconsistent_lifecycle,orphan_feedback,impossible_timestamp"
metrics: "compute[8]: customer_satisfaction,adoption_rate,churn_rate,feature_success,engineering_responsiveness,support_efficiency,customer_sentiment,business_alignment"
success_metrics:
  business_realism:
    minimum: 0.98
  engineering_traceability:
    minimum: 1.0
  feedback_consistency:
    minimum: 1.0
  customer_diversity:
    minimum: 0.95
  lifecycle_validity:
    minimum: 0.99
