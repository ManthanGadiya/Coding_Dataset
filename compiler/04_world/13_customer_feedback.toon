customer_feedback:

  metadata:

    id: WORLD-013

    title: Customer Feedback

    version: 1.0

    status: Stable

    owner: World Engine

    depends_on:

      - compiler/04_world/02_company_generator.toon
      - compiler/04_world/04_project_generator.toon
      - compiler/04_world/08_business_events.toon
      - compiler/04_world/10_incident_generator.toon
      - compiler/04_world/11_feature_requests.toon
      - compiler/04_world/12_technical_debt.toon

    consumed_by:

      - compiler/04_world/14_company_growth.toon
      - compiler/04_world/15_world_state.toon
      - compiler/05_generation/02_episode_generator.toon
      - compiler/05_generation/15_scenario_generator.toon
      - compiler/05_generation/18_reflection_generator.toon

    objective:

      Generate realistic customer interactions, feedback,
      satisfaction trends, adoption metrics, and business
      outcomes that influence engineering decisions.


################################################################################
# CORE PRINCIPLES
################################################################################

principles:

  - customer_driven

  - business_realistic

  - engineering_traceable

  - deterministic

  - reproducible

  - measurable

  - causal

  - evolving


################################################################################
# FEEDBACK SOURCES
################################################################################

sources:

  support_ticket

  feature_request

  bug_report

  customer_survey

  app_store_review

  social_media

  enterprise_account

  sales_team

  customer_success

  user_analytics

  telemetry

  beta_program


################################################################################
# FEEDBACK TYPES
################################################################################

feedback_types:

  praise

  complaint

  usability_issue

  feature_request

  performance_issue

  reliability_issue

  security_concern

  accessibility_issue

  pricing_feedback

  documentation_feedback

  onboarding_feedback

  integration_request


################################################################################
# CUSTOMER SEGMENTS
################################################################################

segments:

  free_users

  premium_users

  enterprise

  startup

  government

  education

  healthcare

  fintech

  developers

  internal_users


################################################################################
# FEEDBACK ATTRIBUTES
################################################################################

attributes:

  feedback_id

  customer_id

  customer_segment

  timestamp

  source

  category

  severity

  affected_product

  affected_features

  business_impact

  engineering_owner

  current_status


################################################################################
# SATISFACTION MODEL
################################################################################

satisfaction:

  metrics:

    nps

    csat

    ces

    retention

    churn

    adoption

    engagement

    renewal_rate

    support_resolution_time


################################################################################
# CUSTOMER JOURNEY
################################################################################

journey:

  discovery

  onboarding

  adoption

  active_usage

  expansion

  renewal

  advocacy

  churn

  reactivation


################################################################################
# ENGINEERING IMPACT
################################################################################

engineering_impact:

  affects:

    roadmap

    feature_priority

    architecture

    technical_debt

    incident_priority

    documentation

    testing

    observability

    staffing


################################################################################
# BUSINESS IMPACT
################################################################################

business_impact:

  revenue

  customer_retention

  reputation

  market_share

  growth

  support_cost

  sales_pipeline

  contract_renewal


################################################################################
# FEEDBACK LIFECYCLE
################################################################################

lifecycle:

  received

  categorized

  triaged

  prioritized

  assigned

  implemented

  validated

  customer_notified

  closed


################################################################################
# CAUSAL RELATIONSHIPS
################################################################################

causality:

  feedback:

    originates_from:

      feature_release

      production_incident

      technical_debt

      usability

      performance

      customer_expectations

    may_trigger:

      feature_request

      bug_fix

      roadmap_change

      architecture_review

      business_event

      engineering_investment


################################################################################
# VALIDATION
################################################################################

validation:

  reject_if:

    missing_customer_segment

    missing_business_impact

    invalid_feedback_type

    inconsistent_lifecycle

    orphan_feedback

    impossible_timestamp


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    customer_satisfaction

    adoption_rate

    churn_rate

    feature_success

    engineering_responsiveness

    support_efficiency

    customer_sentiment

    business_alignment


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  business_realism:

    minimum: 0.98

  engineering_traceability:

    minimum: 1.00

  feedback_consistency:

    minimum: 1.00

  customer_diversity:

    minimum: 0.95

  lifecycle_validity:

    minimum: 0.99

  reproducibility:

    minimum: 1.00
