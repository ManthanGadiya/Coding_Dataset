project_generator:

  metadata:

    id: WORLD-004

    title: Project Generator

    version: 1.0

    status: Stable

    owner: World Engine

    depends_on:

      - compiler/04_world/01_world_generator.toon
      - compiler/04_world/02_company_generator.toon
      - compiler/04_world/03_repository_generator.toon
      - compiler/01_ontology/17_entity_model.toon

    consumed_by:

      - compiler/04_world/05_team_generator.toon
      - compiler/04_world/08_business_events.toon
      - compiler/04_world/09_repository_history.toon
      - compiler/04_world/10_incident_generator.toon
      - compiler/04_world/11_feature_requests.toon
      - compiler/05_generation/02_episode_generator.toon
      - compiler/05_generation/15_scenario_generator.toon

    objective:

      Generate realistic software projects with business goals,
      technical architecture, roadmaps, milestones,
      repositories, stakeholders, and evolving engineering history.


################################################################################
# CORE PRINCIPLES
################################################################################

principles:

  - business_driven

  - engineering_realism

  - deterministic

  - reproducible

  - lifecycle_oriented

  - architecture_consistent

  - historically_consistent

  - scalable


################################################################################
# PROJECT TYPES
################################################################################

project_types:

  greenfield

  brownfield

  modernization

  migration

  research

  maintenance

  open_source

  enterprise_platform

  internal_tool

  customer_product


################################################################################
# PROJECT ATTRIBUTES
################################################################################

attributes:

  project_name

  description

  business_domain

  owner_company

  repositories

  stakeholders

  roadmap

  architecture

  budget

  priority

  risk_level

  compliance_requirements

  start_date

  target_release

  current_phase


################################################################################
# PROJECT PHASES
################################################################################

phases:

  planning

  requirements

  architecture

  implementation

  testing

  deployment

  maintenance

  scaling

  modernization

  retirement


################################################################################
# BUSINESS OBJECTIVES
################################################################################

business_objectives:

  increase_revenue

  reduce_cost

  improve_reliability

  improve_security

  improve_customer_experience

  regulatory_compliance

  platform_growth

  technical_modernization

  research

  automation


################################################################################
# ENGINEERING OBJECTIVES
################################################################################

engineering_objectives:

  modularity

  maintainability

  scalability

  reliability

  security

  observability

  performance

  testability

  portability

  extensibility


################################################################################
# ARCHITECTURE
################################################################################

architecture:

  styles:

    layered

    microservices

    event_driven

    modular_monolith

    hexagonal

    clean_architecture

    serverless

    hybrid

  quality_attributes:

    availability

    scalability

    latency

    throughput

    security

    resilience

    maintainability

    interoperability


################################################################################
# PROJECT ARTIFACTS
################################################################################

artifacts:

  requirements

  architecture_document

  roadmap

  design_decisions

  backlog

  sprint_plan

  release_plan

  testing_strategy

  deployment_plan

  risk_register


################################################################################
# PROJECT METRICS
################################################################################

metrics:

  velocity

  defect_rate

  feature_completion

  technical_debt

  customer_satisfaction

  deployment_frequency

  lead_time

  mean_time_to_recovery

  change_failure_rate


################################################################################
# RELATIONSHIPS
################################################################################

relationships:

  belongs_to:

    company

  owns:

    repositories

    architecture

    roadmap

    milestones

  staffed_by:

    teams

    engineers

  serves:

    customers


################################################################################
# EVOLUTION
################################################################################

evolution:

  supports:

    architecture_changes

    technology_migrations

    roadmap_updates

    requirement_changes

    scope_expansion

    budget_changes

    staffing_changes

    dependency_growth

    technical_debt_accumulation

    performance_optimization


################################################################################
# RANDOMIZATION
################################################################################

randomization:

  deterministic_seed:

    true

  weighted_generation:

    true

  reproducible:

    true

  realistic_distribution:

    true


################################################################################
# VALIDATION
################################################################################

validation:

  reject_if:

    missing_company

    missing_repository

    invalid_phase

    impossible_budget

    inconsistent_architecture

    missing_roadmap

    invalid_dependencies

    orphan_project


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    business_complexity

    engineering_complexity

    architecture_maturity

    roadmap_consistency

    dependency_density

    project_health

    lifecycle_progress


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  business_realism:

    minimum: 0.95

  engineering_realism:

    minimum: 0.96

  architectural_consistency:

    minimum: 0.98

  lifecycle_validity:

    minimum: 1.00

  dependency_consistency:

    minimum: 1.00

  reproducibility:

    minimum: 1.00
