description: "artifacts[10]: requirements,architecture_document,roadmap,design_decisions,backlog,sprint_plan,release_plan,testing_strategy,deployment_plan,risk_register"
project_generator:
  metadata:
    description: "depends_on[4]: compiler/04_world/01_world_generator.toon,compiler/04_world/02_company_generator.toon,compiler/04_world/03_repository_generator.toon,compiler/01_ontology/17_entity_model.toon consumed_by[7]: compiler/04_world/05_team_generator.toon,compiler/04_world/08_business_events.toon,compiler/04_world/09_repository_history.toon,compiler/04_world/10_incident_generator.toon,compiler/04_world/11_feature_requests.toon,compiler/05_generation/02_episode_generator.toon,compiler/05_generation/15_scenario_generator.toon"
    id: WORLD-004
    title: Project Generator
    version: 1.0
    status: Stable
    owner: World Engine
    objective: "\"Generate realistic software projects with business goals, technical architecture, roadmaps, milestones, repositories, stakeholders, and evolving engineering history.\""
architecture[2]: "styles[8]: layered,microservices,event_driven,modular_monolith,hexagonal,clean_architecture,serverless,hybrid","quality_attributes[8]: availability,scalability,latency,throughput,security,resilience,maintainability,interoperability"
metrics: "compute[7]: business_complexity,engineering_complexity,architecture_maturity,roadmap_consistency,dependency_density,project_health,lifecycle_progress"
relationships:
  description: "owns[4]: repositories,architecture,roadmap,milestones staffed_by[2]: teams,engineers"
  belongs_to: company
  serves: customers
evolution: "supports[10]: architecture_changes,technology_migrations,roadmap_updates,requirement_changes,scope_expansion,budget_changes,staffing_changes,dependency_growth,technical_debt_accumulation,performance_optimization"
randomization:
  deterministic_seed: true
  weighted_generation: true
  reproducible: true
  realistic_distribution: true
validation: "reject_if[8]: missing_company,missing_repository,invalid_phase,impossible_budget,inconsistent_architecture,missing_roadmap,invalid_dependencies,orphan_project"
success_metrics:
  business_realism:
    minimum: 0.95
  engineering_realism:
    minimum: 0.96
  architectural_consistency:
    minimum: 0.98
  lifecycle_validity:
    minimum: 1.0
  dependency_consistency:
    minimum: 1.0
  reproducibility:
    minimum: 1.0
