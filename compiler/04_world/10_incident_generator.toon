description: "\"lifecycle[9]: detected,acknowledged,triaged,investigated,mitigated,resolved,verified,postmortem,prevention detection[7]: customer_report,monitoring_alert,automated_test,engineer_observation,security_scan,synthetic_monitoring,anomaly_detection root_causes[11]: human_error,design_flaw,implementation_bug,dependency_update,infrastructure_failure,scaling_issue,operational_error,configuration_drift,security_vulnerability,third_party_failure,unknown response[11]: rollback,hotfix,feature_flag,traffic_shift,capacity_scaling,database_restore,service_restart,dependency_revert,incident_bridge,stakeholder_notification,customer_communication impact[9]: availability,latency,throughput,reliability,revenue,customer_trust,sla_violation,operational_cost,engineering_time participants[9]: incident_commander,tech_lead,sre,backend_engineer,security_engineer,qa_engineer,engineering_manager,product_manager,communications_lead postmortem[8]: timeline,root_cause,contributing_factors,lessons_learned,action_items,ownership,follow_up_deadline,verification prevention[9]: additional_tests,monitoring,documentation,architecture_changes,automation,runbooks,code_review_rules,deployment_guards,observability_improvements\""
incident_generator:
  metadata:
    description: "\"depends_on[7]: compiler/04_world/01_world_generator.toon,compiler/04_world/03_repository_generator.toon,compiler/04_world/05_team_generator.toon,compiler/04_world/06_engineer_profiles.toon,compiler/04_world/07_roles.toon,compiler/04_world/08_business_events.toon,compiler/04_world/09_repository_history.toon consumed_by[6]: compiler/04_world/12_technical_debt.toon,compiler/04_world/15_world_state.toon,compiler/05_generation/02_episode_generator.toon,compiler/05_generation/09_bug_generator.toon,compiler/05_generation/15_scenario_generator.toon,compiler/05_generation/18_reflection_generator.toon\""
    id: WORLD-010
    title: Incident Generator
    version: 1.0
    status: Stable
    owner: World Engine
    objective: "\"\\\"Generate realistic engineering incidents with complete lifecycle, root-cause analysis, response workflows, postmortems, and organizational learning.\\\"\""
severity:
  sev_0:
    description: Organization-wide catastrophic outage.
  sev_1:
    description: Critical customer impact.
  sev_2:
    description: Major degradation.
  sev_3:
    description: Partial functionality affected.
  sev_4:
    description: Minor engineering issue.
causality: "incident[2]: \"triggered_by[5]: repository_change,infrastructure_change,business_event,deployment,configuration_change\",\"may_trigger[6]: rollback,hotfix,architecture_review,technical_debt,documentation_update,monitoring_upgrade\""
validation: "\"reject_if[7]: missing_root_cause,impossible_timeline,missing_owner,invalid_severity,missing_resolution,unresolved_dependencies,inconsistent_postmortem\""
metrics: "\"compute[8]: mean_time_to_detect,mean_time_to_acknowledge,mean_time_to_recover,blast_radius,customer_impact,recurrence_probability,root_cause_accuracy,operational_learning\""
success_metrics:
  incident_realism:
    minimum: 0.98
  causal_consistency:
    minimum: 1.0
  postmortem_quality:
    minimum: 0.96
  timeline_consistency:
    minimum: 1.0
  engineering_value:
    minimum: 0.97
  reproducibility:
    minimum: 1.0
