description: "contributors[8]: onboarding,promotions,ownership_changes,reviewer_history,mentorship,knowledge_transfer,departures,bus_factor_changes dependencies[6]: package_updates,framework_migrations,security_updates,deprecated_packages,version_history,compatibility_changes releases[7]: version,release_notes,deployment_date,rollback_status,known_issues,breaking_changes,migration_guides"
repository_history:
  metadata:
    description: "depends_on[6]: compiler/04_world/01_world_generator.toon,compiler/04_world/03_repository_generator.toon,compiler/04_world/05_team_generator.toon,compiler/04_world/06_engineer_profiles.toon,compiler/04_world/07_roles.toon,compiler/04_world/08_business_events.toon consumed_by[6]: compiler/04_world/10_incident_generator.toon,compiler/04_world/12_technical_debt.toon,compiler/05_generation/02_episode_generator.toon,compiler/05_generation/08_code_generator.toon,compiler/05_generation/11_review_generator.toon,compiler/05_generation/15_scenario_generator.toon"
    id: WORLD-009
    title: Repository History
    version: 1.0
    status: Stable
    owner: World Engine
    objective: "\"Generate realistic repository evolution across months and years, preserving engineering decisions, architectural evolution, contributor activity, technical debt, and software history.\""
timeline:
  beginning: repository_creation
  progression: chronological
commits: "attributes[11]: commit_hash,author,timestamp,branch,message,files_changed,additions,deletions,reviewers,issue_reference,release_reference"
branches[2]: "supports[6]: feature_branch,release_branch,hotfix_branch,experiment_branch,maintenance_branch,long_running_branch","lifecycle[4]: create,merge,delete,archive"
pull_requests[2]: "states[6]: draft,open,changes_requested,approved,merged,closed","captures[6]: reviewers,comments,review_rounds,approvals,merge_strategy,linked_issues"
architecture: "tracks[9]: module_creation,service_split,dependency_changes,api_evolution,database_migrations,design_decisions,adr_history,technology_adoption,architecture_reviews"
engineering: "tracks[10]: testing_growth,documentation_growth,code_quality,linting,formatting,observability,deployment_pipeline,monitoring,automation,reliability"
causality[2]: "every_change[5]: has_reason,has_author,has_review,has_timestamp,has_downstream_effects","supports[4]: event_chains,regression_tracking,root_cause_links,dependency_propagation"
validation: "reject_if[7]: non_chronological_history,orphan_commit,missing_author,impossible_merge,duplicate_commit,inconsistent_branch,broken_causality"
metrics: "compute[10]: repository_age,commit_velocity,review_latency,release_frequency,contributor_turnover,architecture_stability,dependency_churn,code_churn,historical_depth,engineering_maturity"
success_metrics:
  temporal_consistency:
    minimum: 1.0
  causality_accuracy:
    minimum: 1.0
  engineering_realism:
    minimum: 0.98
  repository_traceability:
    minimum: 0.97
  historical_completeness:
    minimum: 0.96
  reproducibility:
    minimum: 1.0
