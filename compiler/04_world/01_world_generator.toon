description: "event_sources[10]: customer_requests,market_changes,production_failures,security_incidents,architecture_reviews,hiring,budget_changes,regulation_changes,technology_advances,infrastructure_failures"
world_generator:
  metadata:
    description: "depends_on[4]: compiler/01_ontology/17_entity_model.toon,compiler/01_ontology/19_dependency_graph.toon,compiler/03_curriculum/10_master_curriculum.toon,compiler/03_curriculum/12_competency_matrix.toon consumed_by[5]: compiler/04_world/02_company_generator.toon,compiler/04_world/03_repository_generator.toon,compiler/04_world/04_project_generator.toon,compiler/05_generation/02_episode_generator.toon,compiler/05_generation/15_scenario_generator.toon"
    id: WORLD-001
    title: World Generator
    version: 1.0
    status: Stable
    owner: World Engine
    objective: "\"Generate realistic engineering worlds that simulate software companies, projects, repositories, engineers, customers, infrastructure, and evolving business environments.\""
philosophy: "principles[9]: realism_before_randomness,internally_consistent,temporally_consistent,reproducible,scalable,domain_diverse,engineering_first,business_driven,evolving_worlds"
world: "entities[16]: companies,repositories,projects,engineers,teams,services,customers,products,infrastructure,deployments,incidents,feature_requests,technical_debt,documentation,research,releases"
properties:
  deterministic_seed:
    required: true
  persistent_state:
    enabled: true
  evolving_timeline:
    enabled: true
  causal_consistency:
    required: true
  historical_memory:
    enabled: true
timeline:
  description: "supports[10]: project_start,feature_development,code_reviews,releases,production_incidents,bug_reports,architecture_changes,customer_feedback,company_growth,technology_migration"
  ordering: chronological
scale[3]: "company_sizes[5]: startup,small,medium,enterprise,global","repository_sizes[5]: tiny,small,medium,large,monorepo","project_complexity[4]: prototype,production,enterprise,mission_critical"
consistency: "maintain[7]: entity_relationships,historical_accuracy,dependency_validity,timeline_order,architecture_integrity,business_constraints,technical_constraints"
randomization:
  deterministic: true
  seed_control:
    enabled: true
  variability: high
  reproducibility: guaranteed
constraints:
  every_project: belongs_to_company
  every_repository: belongs_to_project
  every_engineer: belongs_to_team
  every_incident: references_existing_services
  every_release: follows_development
validation: "reject_if[6]: orphan_entities,impossible_timelines,circular_dependencies,inconsistent_history,missing_relationships,invalid_world_state"
metrics: "compute[7]: world_consistency,entity_density,relationship_density,historical_depth,event_diversity,business_realism,engineering_realism"
success_metrics:
  world_consistency:
    minimum: 1.0
  entity_connectivity:
    minimum: 0.98
  timeline_validity:
    minimum: 1.0
  engineering_realism:
    minimum: 0.95
  business_realism:
    minimum: 0.9
  reproducibility:
    minimum: 1.0
