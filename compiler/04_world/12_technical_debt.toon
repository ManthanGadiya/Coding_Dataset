description: "repayment[10]: refactoring,architecture_redesign,dependency_upgrade,documentation,additional_testing,monitoring,automation,service_split,code_cleanup,rewrite"
technical_debt:
  metadata:
    description: "depends_on[5]: compiler/04_world/03_repository_generator.toon,compiler/04_world/08_business_events.toon,compiler/04_world/09_repository_history.toon,compiler/04_world/10_incident_generator.toon,compiler/04_world/11_feature_requests.toon consumed_by[6]: compiler/04_world/14_company_growth.toon,compiler/04_world/15_world_state.toon,compiler/05_generation/02_episode_generator.toon,compiler/05_generation/08_code_generator.toon,compiler/05_generation/09_bug_generator.toon,compiler/05_generation/18_reflection_generator.toon"
    id: WORLD-012
    title: Technical Debt
    version: 1.0
    status: Stable
    owner: World Engine
    objective: "\"Generate realistic technical debt throughout the software lifecycle, modeling accumulation, prioritization, consequences, repayment, and long-term engineering impact.\""
interest:
  accumulates_over_time: true
prioritization: "based_on[7]: business_risk,engineering_risk,security_risk,operational_risk,implementation_cost,customer_impact,interest_rate"
evolution: "supports[8]: accumulation,repayment,reprioritization,ownership_transfer,compounding_interest,architecture_decay,modernization,migration"
relationships[3]: "caused_by[4]: feature_requests,business_events,incidents,repository_history","affects[7]: repositories,projects,teams,engineers,customers,architecture,deployments","may_trigger[5]: refactoring,architecture_review,production_incident,migration,roadmap_change"
validation: "reject_if[6]: missing_root_cause,missing_owner,negative_interest,impossible_timestamp,orphan_debt,inconsistent_status"
metrics: "compute[9]: debt_score,interest_rate,repayment_velocity,architecture_health,maintainability,engineering_cost,operational_risk,debt_density,modernization_progress"
success_metrics:
  realism:
    minimum: 0.98
  causal_consistency:
    minimum: 1.0
  engineering_value:
    minimum: 0.97
  debt_traceability:
    minimum: 1.0
  lifecycle_consistency:
    minimum: 0.98
  reproducibility:
    minimum: 1.0
