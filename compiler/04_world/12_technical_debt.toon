technical_debt:

  metadata:

    id: WORLD-012

    title: Technical Debt

    version: 1.0

    status: Stable

    owner: World Engine

    depends_on:

      - compiler/04_world/03_repository_generator.toon
      - compiler/04_world/08_business_events.toon
      - compiler/04_world/09_repository_history.toon
      - compiler/04_world/10_incident_generator.toon
      - compiler/04_world/11_feature_requests.toon

    consumed_by:

      - compiler/04_world/14_company_growth.toon
      - compiler/04_world/15_world_state.toon
      - compiler/05_generation/02_episode_generator.toon
      - compiler/05_generation/08_code_generator.toon
      - compiler/05_generation/09_bug_generator.toon
      - compiler/05_generation/18_reflection_generator.toon

    objective:

      Generate realistic technical debt throughout the software
      lifecycle, modeling accumulation, prioritization,
      consequences, repayment, and long-term engineering impact.


################################################################################
# CORE PRINCIPLES
################################################################################

principles:

  - cumulative

  - causal

  - measurable

  - engineering_realism

  - deterministic

  - reproducible

  - business_aware

  - continuously_evolving


################################################################################
# DEBT CATEGORIES
################################################################################

categories:

  code_debt

  architecture_debt

  testing_debt

  documentation_debt

  infrastructure_debt

  deployment_debt

  security_debt

  observability_debt

  dependency_debt

  process_debt


################################################################################
# DEBT SOURCES
################################################################################

sources:

  rushed_feature

  temporary_workaround

  deadline_pressure

  architecture_compromise

  skipped_testing

  skipped_review

  outdated_dependency

  missing_documentation

  production_hotfix

  failed_refactoring

  legacy_system

  abandoned_feature


################################################################################
# DEBT ATTRIBUTES
################################################################################

attributes:

  debt_id

  category

  severity

  repository

  affected_modules

  introduced_by

  introduction_date

  root_cause

  estimated_effort

  interest_rate

  owner

  current_status


################################################################################
# SEVERITY
################################################################################

severity:

  negligible

  low

  medium

  high

  critical

  existential


################################################################################
# CONSEQUENCES
################################################################################

consequences:

  slower_development

  increased_bug_rate

  reduced_velocity

  architecture_complexity

  onboarding_difficulty

  deployment_risk

  incident_probability

  security_risk

  maintenance_cost

  customer_impact


################################################################################
# INTEREST MODEL
################################################################################

interest:

  accumulates_over_time: true

  affected_by:

    repository_age

    dependency_growth

    architecture_complexity

    deployment_frequency

    team_turnover

    code_churn

    unresolved_incidents


################################################################################
# REPAYMENT STRATEGIES
################################################################################

repayment:

  refactoring

  architecture_redesign

  dependency_upgrade

  documentation

  additional_testing

  monitoring

  automation

  service_split

  code_cleanup

  rewrite


################################################################################
# PRIORITIZATION
################################################################################

prioritization:

  based_on:

    business_risk

    engineering_risk

    security_risk

    operational_risk

    implementation_cost

    customer_impact

    interest_rate


################################################################################
# EVOLUTION
################################################################################

evolution:

  supports:

    accumulation

    repayment

    reprioritization

    ownership_transfer

    compounding_interest

    architecture_decay

    modernization

    migration


################################################################################
# RELATIONSHIPS
################################################################################

relationships:

  caused_by:

    feature_requests

    business_events

    incidents

    repository_history

  affects:

    repositories

    projects

    teams

    engineers

    customers

    architecture

    deployments

  may_trigger:

    refactoring

    architecture_review

    production_incident

    migration

    roadmap_change


################################################################################
# VALIDATION
################################################################################

validation:

  reject_if:

    missing_root_cause

    missing_owner

    negative_interest

    impossible_timestamp

    orphan_debt

    inconsistent_status


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    debt_score

    interest_rate

    repayment_velocity

    architecture_health

    maintainability

    engineering_cost

    operational_risk

    debt_density

    modernization_progress


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  realism:

    minimum: 0.98

  causal_consistency:

    minimum: 1.00

  engineering_value:

    minimum: 0.97

  debt_traceability:

    minimum: 1.00

  lifecycle_consistency:

    minimum: 0.98

  reproducibility:

    minimum: 1.00
