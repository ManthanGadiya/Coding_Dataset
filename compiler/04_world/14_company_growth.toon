company_growth:

  metadata:

    id: WORLD-014

    title: Company Growth

    version: 1.0

    status: Stable

    owner: World Engine

    depends_on:

      - compiler/04_world/02_company_generator.toon
      - compiler/04_world/05_team_generator.toon
      - compiler/04_world/08_business_events.toon
      - compiler/04_world/11_feature_requests.toon
      - compiler/04_world/12_technical_debt.toon
      - compiler/04_world/13_customer_feedback.toon

    consumed_by:

      - compiler/04_world/15_world_state.toon
      - compiler/05_generation/02_episode_generator.toon
      - compiler/05_generation/15_scenario_generator.toon
      - compiler/09_optimization/09_world_optimizer.toon

    objective:

      Simulate long-term organizational evolution, including
      growth, restructuring, technology adoption, engineering
      maturity, and business transformation.


################################################################################
# CORE PRINCIPLES
################################################################################

principles:

  - long_term_evolution

  - deterministic

  - reproducible

  - business_realism

  - engineering_realism

  - causality

  - organizational_learning

  - adaptive_growth


################################################################################
# GROWTH STAGES
################################################################################

stages:

  idea

  startup

  seed

  series_a

  series_b

  scaleup

  enterprise

  multinational

  platform_company

  mature_enterprise


################################################################################
# GROWTH DRIVERS
################################################################################

drivers:

  customer_growth

  revenue_growth

  funding

  acquisitions

  partnerships

  innovation

  engineering_efficiency

  international_expansion

  product_success

  market_conditions


################################################################################
# ORGANIZATIONAL EVOLUTION
################################################################################

organization:

  supports:

    hiring

    restructuring

    promotions

    department_creation

    team_splitting

    management_layers

    global_offices

    leadership_changes


################################################################################
# ENGINEERING EVOLUTION
################################################################################

engineering:

  maturity:

    experimental

    emerging

    standardized

    optimized

    autonomous

  improvements:

    ci_cd

    observability

    testing

    architecture

    security

    developer_experience

    automation

    platform_engineering


################################################################################
# TECHNOLOGY EVOLUTION
################################################################################

technology:

  supports:

    language_adoption

    framework_migration

    cloud_migration

    infrastructure_modernization

    ai_adoption

    platform_standardization

    legacy_retirement

    tooling_improvements


################################################################################
# BUSINESS EVOLUTION
################################################################################

business:

  supports:

    new_products

    market_expansion

    mergers

    acquisitions

    compliance_growth

    pricing_changes

    strategic_pivots

    ecosystem_partnerships


################################################################################
# RISK FACTORS
################################################################################

risks:

  rapid_scaling

  technical_debt

  organizational_complexity

  security_exposure

  market_disruption

  talent_loss

  operational_overhead

  regulatory_changes

  customer_churn


################################################################################
# MATURITY METRICS
################################################################################

maturity:

  engineering

  architecture

  operations

  security

  documentation

  testing

  deployment

  reliability

  governance


################################################################################
# LONG-TERM EFFECTS
################################################################################

effects:

  repository_growth

  service_growth

  architecture_complexity

  dependency_growth

  team_specialization

  organizational_memory

  knowledge_distribution

  operational_cost


################################################################################
# CAUSAL RELATIONSHIPS
################################################################################

causality:

  company_growth:

    influenced_by:

      customer_feedback

      business_events

      feature_success

      technical_debt

      engineering_velocity

      market_conditions

    influences:

      hiring

      projects

      repositories

      technology_choices

      engineering_processes

      world_state


################################################################################
# VALIDATION
################################################################################

validation:

  reject_if:

    impossible_growth_rate

    inconsistent_stage

    missing_growth_driver

    orphan_company

    invalid_timeline

    contradictory_history


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    organizational_maturity

    engineering_maturity

    architecture_maturity

    innovation_rate

    growth_velocity

    operational_efficiency

    resilience

    adaptability


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  business_realism:

    minimum: 0.98

  engineering_realism:

    minimum: 0.98

  causal_consistency:

    minimum: 1.00

  historical_consistency:

    minimum: 1.00

  organizational_diversity:

    minimum: 0.95

  reproducibility:

    minimum: 1.00
