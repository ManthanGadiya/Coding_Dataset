roles:

  metadata:

    id: WORLD-007

    title: Engineering Roles

    version: 1.0

    status: Stable

    owner: World Engine

    depends_on:

      - compiler/04_world/05_team_generator.toon
      - compiler/04_world/06_engineer_profiles.toon
      - compiler/01_ontology/02_capabilities.toon

    consumed_by:

      - compiler/04_world/08_business_events.toon
      - compiler/04_world/09_repository_history.toon
      - compiler/04_world/10_incident_generator.toon
      - compiler/05_generation/02_episode_generator.toon
      - compiler/05_generation/11_review_generator.toon
      - compiler/05_generation/16_dialogue_generator.toon

    objective:

      Define realistic engineering roles, responsibilities,
      authority, decision boundaries, collaboration patterns,
      and behavioral expectations throughout the software lifecycle.


################################################################################
# CORE PRINCIPLES
################################################################################

principles:

  - responsibility_driven

  - ownership_based

  - authority_defined

  - collaboration_first

  - competency_aligned

  - evolving

  - reproducible

  - realistic


################################################################################
# ROLE CATALOG
################################################################################

roles:

  intern

  junior_engineer

  software_engineer

  senior_engineer

  staff_engineer

  principal_engineer

  distinguished_engineer

  tech_lead

  engineering_manager

  architect

  sre

  devops_engineer

  security_engineer

  qa_engineer

  product_manager

  engineering_director

  vp_engineering

  cto


################################################################################
# RESPONSIBILITIES
################################################################################

responsibilities:

  intern:

    - learn

    - implement_small_tasks

    - write_tests

    - receive_reviews

  junior_engineer:

    - implement_features

    - fix_bugs

    - write_tests

    - improve_documentation

  software_engineer:

    - own_features

    - review_code

    - optimize_modules

    - collaborate_cross_team

  senior_engineer:

    - design_systems

    - mentor_engineers

    - architecture_reviews

    - incident_response

  staff_engineer:

    - cross_team_architecture

    - technical_strategy

    - dependency_management

  principal_engineer:

    - organization_architecture

    - technology_direction

    - engineering_standards

  architect:

    - architecture_design

    - architecture_reviews

    - technology_selection

  tech_lead:

    - sprint_planning

    - technical_decisions

    - code_reviews

    - unblock_team

  engineering_manager:

    - planning

    - hiring

    - performance

    - roadmap_execution

  sre:

    - reliability

    - monitoring

    - automation

    - incident_management

  security_engineer:

    - threat_modeling

    - security_reviews

    - compliance

    - vulnerability_response

  qa_engineer:

    - testing_strategy

    - automation

    - release_validation

  product_manager:

    - requirements

    - prioritization

    - stakeholder_alignment

  cto:

    - engineering_vision

    - organization_strategy

    - technology_investment


################################################################################
# DECISION AUTHORITY
################################################################################

authority:

  architecture

  hiring

  releases

  deployments

  infrastructure

  roadmap

  security

  production_incidents

  technical_debt

  dependency_selection


################################################################################
# OWNERSHIP MODEL
################################################################################

ownership:

  features

  services

  repositories

  infrastructure

  documentation

  monitoring

  deployment

  customer_issues

  architecture

  technical_debt


################################################################################
# INTERACTION MATRIX
################################################################################

collaboration:

  participates_in:

    planning

    standups

    design_reviews

    code_reviews

    architecture_reviews

    retrospectives

    incident_reviews

    release_planning

  communicates_via:

    pull_requests

    issue_tracker

    design_documents

    architecture_records

    chat

    meetings

    runbooks


################################################################################
# ROLE EVOLUTION
################################################################################

progression:

  intern ->
  junior_engineer ->
  software_engineer ->
  senior_engineer ->
  staff_engineer ->
  principal_engineer ->
  distinguished_engineer

  leadership:

    senior_engineer ->
    tech_lead ->
    engineering_manager ->
    engineering_director ->
    vp_engineering ->
    cto


################################################################################
# DECISION BEHAVIOR
################################################################################

behavior:

  prioritize:

    correctness

    maintainability

    scalability

    reliability

    security

    business_value

    customer_impact

  evaluate:

    tradeoffs

    cost

    performance

    technical_debt

    operational_risk


################################################################################
# VALIDATION
################################################################################

validation:

  reject_if:

    undefined_role

    missing_responsibilities

    invalid_authority

    inconsistent_progression

    conflicting_ownership

    impossible_decision_scope


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    ownership_clarity

    authority_consistency

    collaboration_density

    decision_complexity

    role_specialization

    organizational_alignment


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  role_consistency:

    minimum: 1.00

  organizational_realism:

    minimum: 0.97

  ownership_consistency:

    minimum: 0.98

  collaboration_quality:

    minimum: 0.95

  decision_realism:

    minimum: 0.96

  reproducibility:

    minimum: 1.00
