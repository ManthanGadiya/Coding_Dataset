team_generator:

  metadata:

    id: WORLD-005

    title: Team Generator

    version: 1.0

    status: Stable

    owner: World Engine

    depends_on:

      - compiler/04_world/01_world_generator.toon
      - compiler/04_world/02_company_generator.toon
      - compiler/04_world/03_repository_generator.toon
      - compiler/04_world/04_project_generator.toon
      - compiler/01_ontology/17_entity_model.toon

    consumed_by:

      - compiler/04_world/06_engineer_profiles.toon
      - compiler/04_world/07_roles.toon
      - compiler/04_world/08_business_events.toon
      - compiler/04_world/09_repository_history.toon
      - compiler/05_generation/02_episode_generator.toon
      - compiler/05_generation/11_review_generator.toon

    objective:

      Generate realistic software engineering teams with evolving
      structures, ownership, collaboration patterns, communication,
      and engineering responsibilities.


################################################################################
# CORE PRINCIPLES
################################################################################

principles:

  - engineering_realism

  - business_alignment

  - deterministic

  - reproducible

  - collaboration_first

  - ownership_driven

  - organizational_consistency

  - evolving_teams


################################################################################
# TEAM TYPES
################################################################################

team_types:

  platform

  backend

  frontend

  mobile

  ai

  mlops

  infrastructure

  sre

  devops

  security

  qa

  developer_experience

  data_engineering

  research

  architecture


################################################################################
# TEAM ATTRIBUTES
################################################################################

attributes:

  team_name

  team_type

  project

  company

  mission

  responsibilities

  ownership

  size

  maturity

  timezone_distribution

  communication_style

  decision_model


################################################################################
# TEAM STRUCTURE
################################################################################

structure:

  engineering_manager

  tech_lead

  senior_engineers

  mid_engineers

  junior_engineers

  interns

  product_manager

  designer

  qa_engineer

  sre

  architect


################################################################################
# RESPONSIBILITIES
################################################################################

responsibilities:

  feature_development

  bug_fixes

  code_review

  architecture

  deployment

  monitoring

  incident_response

  documentation

  mentoring

  technical_planning

  roadmap_execution

  dependency_management


################################################################################
# OWNERSHIP MODEL
################################################################################

ownership:

  services

  repositories

  infrastructure

  documentation

  deployments

  alerts

  production_incidents

  technical_debt

  architecture_decisions


################################################################################
# COLLABORATION
################################################################################

collaboration:

  planning

  design_review

  code_review

  pair_programming

  architecture_review

  retrospective

  incident_review

  knowledge_sharing

  cross_team_sync


################################################################################
# COMMUNICATION
################################################################################

communication:

  synchronous

  asynchronous

  design_documents

  pull_requests

  issue_tracking

  architecture_records

  chat

  meetings

  runbooks


################################################################################
# TEAM DYNAMICS
################################################################################

dynamics:

  onboarding

  promotions

  transfers

  hiring

  attrition

  mentorship

  conflict_resolution

  leadership_changes

  knowledge_distribution

  bus_factor


################################################################################
# PERFORMANCE CHARACTERISTICS
################################################################################

performance:

  velocity

  review_latency

  deployment_frequency

  defect_rate

  incident_rate

  technical_debt_growth

  documentation_quality

  collaboration_score


################################################################################
# EVOLUTION
################################################################################

evolution:

  supports:

    team_growth

    reorganization

    ownership_transfer

    technology_adoption

    process_improvement

    scaling

    mergers

    project_reassignment


################################################################################
# RELATIONSHIPS
################################################################################

relationships:

  belongs_to:

    company

    project

  owns:

    repositories

    services

    infrastructure

  consists_of:

    engineers

    managers

    architects

  collaborates_with:

    other_teams


################################################################################
# RANDOMIZATION
################################################################################

randomization:

  deterministic_seed:

    true

  weighted_generation:

    true

  reproducible:

    true

  realistic_distribution:

    true


################################################################################
# VALIDATION
################################################################################

validation:

  reject_if:

    missing_team_lead

    orphan_team

    missing_project

    missing_company

    invalid_team_size

    inconsistent_ownership

    impossible_structure


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    collaboration_density

    ownership_clarity

    communication_efficiency

    engineering_maturity

    organizational_health

    bus_factor

    knowledge_distribution

    team_resilience


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  organizational_consistency:

    minimum: 1.00

  engineering_realism:

    minimum: 0.96

  collaboration_quality:

    minimum: 0.94

  ownership_consistency:

    minimum: 0.98

  reproducibility:

    minimum: 1.00

  team_diversity:

    minimum: 0.90
