curriculum_graph:

  metadata:

    id: CURR-009

    title: Curriculum Graph

    version: 1.0

    status: Stable

    owner: Curriculum Engine

    depends_on:

      - compiler/03_curriculum/01_learning_order.toon
      - compiler/03_curriculum/02_skill_progression.toon
      - compiler/03_curriculum/03_domain_progression.toon
      - compiler/03_curriculum/04_difficulty_progression.toon
      - compiler/03_curriculum/05_prerequisite_graph.toon
      - compiler/03_curriculum/06_sampling_strategy.toon
      - compiler/03_curriculum/07_dataset_balancing.toon
      - compiler/03_curriculum/08_spacing_algorithm.toon

    consumed_by:

      - compiler/03_curriculum/10_master_curriculum.toon
      - compiler/05_generation/19_dataset_builder.toon
      - compiler/08_validation/03_graph_validation.toon
      - compiler/09_optimization/07_curriculum_optimizer.toon

    objective:

      Build a unified executable curriculum graph that governs
      progression, reinforcement, sampling, and curriculum traversal.


################################################################################
# GRAPH TYPE
################################################################################

graph:

  type:

    Directed Acyclic Graph

  traversal:

    topological

  deterministic:

    true

  cyclic_edges:

    forbidden


################################################################################
# NODE TYPES
################################################################################

node_types:

  concept

  skill

  domain

  milestone

  project

  assessment

  reinforcement

  review

  capstone

  mastery


################################################################################
# EDGE TYPES
################################################################################

edge_types:

  prerequisite

  progression

  reinforcement

  review

  integration

  specialization

  transfer

  dependency


################################################################################
# ROOT NODES
################################################################################

roots:

  Programming Fundamentals

  Mathematics

  Computer Fundamentals

  Engineering Mindset


################################################################################
# CURRICULUM FLOW
################################################################################

flow:

  Foundations:

    next:

      - Core Computer Science

  Core Computer Science:

    next:

      - Software Engineering

  Software Engineering:

    next:

      - Backend Engineering
      - Frontend Engineering

  Backend Engineering:

    next:

      - Databases
      - Networking
      - APIs

  Infrastructure:

    next:

      - Cloud Engineering

  Cloud Engineering:

    next:

      - Production Engineering

  Production Engineering:

    next:

      - AI Engineering

  AI Engineering:

    next:

      - Agent Engineering

  Agent Engineering:

    next:

      - Autonomous Engineering


################################################################################
# REINFORCEMENT EDGES
################################################################################

reinforcement:

  Programming Fundamentals:

    revisit:

      - Debugging
      - Algorithms
      - Backend

  Algorithms:

    revisit:

      - AI Engineering
      - Distributed Systems

  Testing:

    revisit:

      - Production Engineering

  Security:

    revisit:

      - Backend Engineering
      - Cloud Engineering
      - Production Engineering

  Architecture:

    revisit:

      - Agent Engineering
      - Autonomous Engineering


################################################################################
# CAPSTONE MILESTONES
################################################################################

milestones:

  Foundation Project

  DSA Project

  Backend API

  Distributed System

  Production Deployment

  AI Application

  Coding Agent

  Autonomous Software Engineer


################################################################################
# MASTERY CONDITIONS
################################################################################

mastery:

  requires:

    - prerequisite_completion

    - assessment_success

    - reinforcement_complete

    - transfer_success

    - project_completion

    - reasoning_threshold


################################################################################
# TRAVERSAL RULES
################################################################################

traversal:

  allow_parallel_learning:

    true

  maximum_parallel_domains:

    2

  revisit_before_new_stage:

    true

  block_on_missing_prerequisites:

    true

  prioritize_transfer_learning:

    true


################################################################################
# GRAPH OPTIMIZATION
################################################################################

optimization:

  minimize:

    - cognitive_load

    - context_switches

    - redundant_examples

  maximize:

    - transfer_learning

    - retention

    - reasoning_growth

    - engineering_intuition


################################################################################
# VALIDATION
################################################################################

validation:

  reject_if:

    - cyclic_dependency

    - unreachable_node

    - invalid_transition

    - skipped_prerequisite

    - orphan_node

    - disconnected_graph


################################################################################
# METRICS
################################################################################

metrics:

  compute:

    graph_depth

    graph_width

    traversal_cost

    prerequisite_density

    reinforcement_density

    curriculum_efficiency

    reasoning_growth_rate

    transfer_score

    mastery_rate


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  graph_validity:

    minimum: 1.00

  curriculum_efficiency:

    minimum: 0.95

  mastery_rate:

    minimum: 0.90

  transfer_learning:

    minimum: 0.90

  reasoning_growth:

    minimum: 0.92

  reinforcement_coverage:

    minimum: 0.90

  prerequisite_accuracy:

    minimum: 1.00
