description: "\"root_nodes[4]: Programming Fundamentals,Mathematics,Computer Fundamentals,Tooling Fundamentals\""
prerequisite_graph:
  metadata:
    description: "\"depends_on[5]: compiler/01_ontology/19_dependency_graph.toon,compiler/03_curriculum/01_learning_order.toon,compiler/03_curriculum/02_skill_progression.toon,compiler/03_curriculum/03_domain_progression.toon,compiler/03_curriculum/04_difficulty_progression.toon consumed_by[5]: compiler/03_curriculum/06_sampling_strategy.toon,compiler/03_curriculum/09_curriculum_graph.toon,compiler/03_curriculum/10_master_curriculum.toon,compiler/05_generation/19_dataset_builder.toon,compiler/08_validation/03_graph_validation.toon\""
    id: CURR-005
    title: Prerequisite Graph
    version: 1.0
    status: Stable
    owner: Curriculum Engine
    objective: Represent all prerequisite relationships as a Directed Acyclic Graph (DAG) to guarantee valid curriculum generation.
graph_rules:
  structure:
    directed: true
    acyclic: true
    connected: true
    layered: true
    deterministic: true
dependencies:
  description: "\"\\\"Distributed Systems\\\": requires[2]: Networking,Architecture enables[1]: Cloud Engineering \\\"Cloud Engineering\\\": requires[1]: Distributed Systems enables[1]: Production Engineering \\\"Production Engineering\\\": requires[2]: Architecture,Cloud Engineering enables[1]: AI Engineering \\\"AI Engineering\\\": requires[3]: Algorithms,Backend Engineering,Production Engineering enables[1]: Agent Engineering \\\"Agent Engineering\\\": requires[4]: AI Engineering,Planning,Reflection,Tool Use enables[1]: Autonomous Engineering \\\"Autonomous Engineering\\\": requires[1]: Agent Engineering\""
  Variables: "\"enables[2]: Memory,Scope\""
  Functions: "\"enables[3]: Recursion,Modules,APIs\""
  Memory: "\"enables[3]: Pointers,Garbage Collection,Performance\""
  Collections: "\"enables[1]: Data Structures\""
cross_dependencies:
  description: "\"\\\"Code Review\\\": depends_on[1]: Software Engineering\""
  Testing: "\"depends_on[2]: Functions,Modules\""
  Security: "\"depends_on[2]: Networking,Backend Engineering\""
  Performance: "\"depends_on[2]: Algorithms,Memory\""
  Debugging: "\"depends_on[1]: Programming Fundamentals\""
  Documentation: "\"depends_on[1]: Software Engineering\""
  DevOps: "\"depends_on[2]: Backend Engineering,Cloud Engineering\""
topological_constraints:
  every_parent_before_child: true
  deterministic_order: true
  stable_generation: true
  reproducible_builds: true
metrics: "\"measure[7]: graph_depth,graph_width,average_branching_factor,longest_dependency_chain,prerequisite_density,dependency_reuse,knowledge_reachability\""
success_metrics:
  graph_validity:
    minimum: 1.0
  cyclic_dependencies:
    maximum: 0
  unreachable_nodes:
    maximum: 0
  prerequisite_accuracy:
    minimum: 1.0
  deterministic_traversal:
    minimum: 1.0
  curriculum_consistency:
    minimum: 0.99
