master_curriculum:

  metadata:

    id: CURR-010

    title: Master Curriculum

    version: 1.0

    status: Stable

    owner: Curriculum Engine

    depends_on:

      - compiler/03_curriculum/01_learning_order.toon
      - compiler/03_curriculum/02_skill_progression.toon
      - compiler/03_curriculum/03_domain_progression.toon
      - compiler/03_curriculum/04_difficulty_progression.toon
      - compiler/03_curriculum/05_prerequisite_graph.toon
      - compiler/03_curriculum/06_sampling_strategy.toon
      - compiler/03_curriculum/07_dataset_balancing.toon
      - compiler/03_curriculum/08_spacing_algorithm.toon
      - compiler/03_curriculum/09_curriculum_graph.toon

    consumed_by:

      - compiler/05_generation/19_dataset_builder.toon
      - compiler/08_validation/09_dataset_validation.toon
      - compiler/09_optimization/07_curriculum_optimizer.toon

    objective:

      Produce the canonical executable curriculum used by every
      dataset generation pipeline.


################################################################################
# CURRICULUM PHILOSOPHY
################################################################################

philosophy:

  maximize:

    - engineering_reasoning

    - transfer_learning

    - production_readiness

    - autonomous_problem_solving

    - long_term_retention

  minimize:

    - memorization

    - redundant_examples

    - isolated_knowledge

    - curriculum_bias

    - catastrophic_forgetting


################################################################################
# EXECUTION PIPELINE
################################################################################

pipeline:

  step_01:

    learning_order

  step_02:

    skill_progression

  step_03:

    domain_progression

  step_04:

    difficulty_progression

  step_05:

    prerequisite_validation

  step_06:

    sampling

  step_07:

    balancing

  step_08:

    spacing

  step_09:

    curriculum_graph

  step_10:

    dataset_generation


################################################################################
# CURRICULUM STAGES
################################################################################

stages:

  stage:

    id: STAGE-001

    name: Foundations

    domains:

      - Programming Fundamentals
      - Computer Fundamentals
      - Mathematics

    target_mastery:

      0.95

  stage:

    id: STAGE-002

    name: Core Engineering

    domains:

      - Algorithms
      - Data Structures
      - Software Engineering

    target_mastery:

      0.92

  stage:

    id: STAGE-003

    name: Application Engineering

    domains:

      - Backend
      - Databases
      - Networking

    target_mastery:

      0.90

  stage:

    id: STAGE-004

    name: Systems Engineering

    domains:

      - Architecture
      - Distributed Systems
      - Cloud

    target_mastery:

      0.88

  stage:

    id: STAGE-005

    name: Production Engineering

    domains:

      - DevOps
      - Monitoring
      - Reliability
      - Security

    target_mastery:

      0.87

  stage:

    id: STAGE-006

    name: AI Engineering

    domains:

      - Machine Learning
      - LLM Engineering
      - Vector Databases
      - RAG
      - Fine Tuning

    target_mastery:

      0.86

  stage:

    id: STAGE-007

    name: Agent Engineering

    domains:

      - Planning
      - Memory
      - Tool Use
      - Reflection
      - Multi-Agent Systems

    target_mastery:

      0.85

  stage:

    id: STAGE-008

    name: Autonomous Engineering

    domains:

      - Autonomous Coding
      - Autonomous Review
      - Autonomous Debugging
      - Autonomous Architecture
      - Self Improvement

    target_mastery:

      0.84


################################################################################
# GLOBAL CONSTRAINTS
################################################################################

constraints:

  prerequisites:

    mandatory

  curriculum_graph:

    mandatory

  reinforcement:

    mandatory

  balancing:

    mandatory

  spacing:

    mandatory

  adaptive_sampling:

    enabled

  deterministic_builds:

    enabled


################################################################################
# COMPILATION RULES
################################################################################

compiler_rules:

  always:

    validate_prerequisites

    validate_curriculum_graph

    validate_balancing

    validate_spacing

    validate_sampling

    validate_stage_completion

  never:

    skip_stage

    violate_dependencies

    exceed_complexity_budget

    generate_duplicate_curricula


################################################################################
# OUTPUT CONTRACT
################################################################################

outputs:

  curriculum_graph

  ordered_learning_path

  prerequisite_map

  sampling_policy

  balancing_policy

  spacing_schedule

  mastery_targets

  validation_constraints


################################################################################
# OPTIMIZATION OBJECTIVES
################################################################################

optimization:

  optimize_for:

    - engineering_intuition

    - reasoning_quality

    - production_capability

    - autonomous_capability

    - sample_efficiency

    - knowledge_density

  avoid:

    - shallow_learning

    - overfitting

    - shortcut_learning

    - domain_collapse

    - curriculum_fragmentation


################################################################################
# VALIDATION
################################################################################

validation:

  required:

    prerequisite_graph_valid

    curriculum_graph_valid

    stage_order_valid

    sampling_valid

    balancing_valid

    spacing_valid

    deterministic_execution

    reproducible_builds


################################################################################
# SUCCESS METRICS
################################################################################

success_metrics:

  curriculum_integrity:

    minimum: 1.00

  stage_completion:

    minimum: 1.00

  prerequisite_accuracy:

    minimum: 1.00

  curriculum_efficiency:

    minimum: 0.95

  reasoning_growth:

    minimum: 0.92

  engineering_intuition:

    minimum: 0.90

  autonomous_readiness:

    minimum: 0.85
