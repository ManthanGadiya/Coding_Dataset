description: "\"outputs[8]: curriculum_graph,ordered_learning_path,prerequisite_map,sampling_policy,balancing_policy,spacing_schedule,mastery_targets,validation_constraints\""
master_curriculum:
  metadata:
    description: "\"depends_on[9]: compiler/03_curriculum/01_learning_order.toon,compiler/03_curriculum/02_skill_progression.toon,compiler/03_curriculum/03_domain_progression.toon,compiler/03_curriculum/04_difficulty_progression.toon,compiler/03_curriculum/05_prerequisite_graph.toon,compiler/03_curriculum/06_sampling_strategy.toon,compiler/03_curriculum/07_dataset_balancing.toon,compiler/03_curriculum/08_spacing_algorithm.toon,compiler/03_curriculum/09_curriculum_graph.toon consumed_by[3]: compiler/05_generation/19_dataset_builder.toon,compiler/08_validation/09_dataset_validation.toon,compiler/09_optimization/07_curriculum_optimizer.toon\""
    id: CURR-010
    title: Master Curriculum
    version: 1.0
    status: Stable
    owner: Curriculum Engine
    objective: Produce the canonical executable curriculum used by every dataset generation pipeline.
pipeline:
  step_01: learning_order
  step_02: skill_progression
  step_03: domain_progression
  step_04: difficulty_progression
  step_05: prerequisite_validation
  step_06: sampling
  step_07: balancing
  step_08: spacing
  step_09: curriculum_graph
  step_10: dataset_generation
stages:
  stage:
    description: "\"domains[5]: Autonomous Coding,Autonomous Review,Autonomous Debugging,Autonomous Architecture,Self Improvement\""
    id: STAGE-008
    name: Autonomous Engineering
    target_mastery: 0.84
constraints:
  prerequisites: mandatory
  curriculum_graph: mandatory
  reinforcement: mandatory
  balancing: mandatory
  spacing: mandatory
  adaptive_sampling: enabled
  deterministic_builds: enabled
validation: "\"required[8]: prerequisite_graph_valid,curriculum_graph_valid,stage_order_valid,sampling_valid,balancing_valid,spacing_valid,deterministic_execution,reproducible_builds\""
success_metrics:
  curriculum_integrity:
    minimum: 1.0
  stage_completion:
    minimum: 1.0
  prerequisite_accuracy:
    minimum: 1.0
  curriculum_efficiency:
    minimum: 0.95
  reasoning_growth:
    minimum: 0.92
  engineering_intuition:
    minimum: 0.9
  autonomous_readiness:
    minimum: 0.85
